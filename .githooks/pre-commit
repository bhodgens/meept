#!/bin/bash
# Main pre-commit hook - runs all quality and security checks
#
# Runs the following checks in order:
# 1. go build on staged packages (+ clean downstream importers)
# 2. consumer test-compile (clean downstream packages' _test.go vs staged changes)
# 3. Deferred item validation (findings docs)
# 4. Mutex I/O analyzer (Go concurrency)
# 5. Staticcheck U1000 (unused code)
# 6. go vet (common Go bugs)
# 7. Setter nil-safety (typed-nil panics)
# 8. Selflock analyzer (self-deadlocking locks)
# 9. gosec (security vulnerabilities) - if installed
# 10. Error handling patterns (anti-patterns)
# 11. Predictable ID detection (use pkg/id.Generate)
# 12. SQLite pragma check (WAL + busy_timeout)
# 13. Channel close-then-nil detection (sync.Once pattern)
# 14. Concurrency annotations (informational)
# 15. Mutation testing (report only)
# 16. Feature documentation (code changes)
# 17. Non-English character check (CJK/Hangul/fullwidth in staged text files)
# 18. Dart formatting (staged ui/flutter_ui Dart files)
# 19. e2e enforcement (affected suites + new-feature coverage rule)
# 20. deadcode reachability (blocks NEW unwired functions vs baseline)
#
# Pre-flight [0/20]: pre-commit-worktreecfg repairs a core.bare=true flip. It
# runs BEFORE the numbered chain because that flip breaks `go build`
# ("error obtaining VCS status: exit status 128"), which would abort gate 1.
#
# Requires bash >= 4 (macOS /bin/bash is 3.2): sub-hooks carry
# /opt/homebrew/bin/bash shebangs.
#
# Skip with --no-verify for emergencies only.

set -e

# Pin the toolchain every sub-hook's go invocation uses (go run/list/vet/build
# and the x/tools-linked analyzers) to go.mod's `toolchain` line. WHY:
# GOTOOLCHAIN=auto never downgrades, so a newer local Go writes export data
# the pinned golang.org/x/tools cannot decode and every analyzer gate fails
# with bogus typecheck errors. An explicitly-set GOTOOLCHAIN in the calling
# environment wins (deliberate probes stay possible:
#   GOTOOLCHAIN=auto .githooks/pre-commit
# ); unset or auto resolves to the pin, because auto always picks the newer
# ambient Go — the exact failure this pin exists to prevent.
if [ -z "$GOTOOLCHAIN" ] || [ "$GOTOOLCHAIN" = "auto" ]; then
    export GOTOOLCHAIN="$(sed -n 's/^toolchain[[:space:]]//p' "$PWD/go.mod" | head -1)"
fi
if [ -z "$GOTOOLCHAIN" ]; then
    export GOTOOLCHAIN="$(sed -n 's/^go[[:space:]]//p' "$PWD/go.mod" | head -1)"
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 0. worktree config guard (core.bare=true self-heal) — PRE-FLIGHT, before the
# numbered chain. WHY first: a bare-config flip makes `go build` fail with
# "error obtaining VCS status: exit status 128", so gate [1/20] pre-commit-build
# would abort the chain (set -e) before a later guard could repair it.
echo -e "\e[34m[0/20]\e[0m Checking worktree configuration (core.bare guard)..."
"$SCRIPT_DIR/pre-commit-worktreecfg"

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Pre-commit Quality Checks"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# 1. go build (catches compile errors before anything else runs)
echo -e "\e[34m[1/20]\e[0m Building staged packages..."
"$SCRIPT_DIR/pre-commit-build"

# 2. consumer test-compile (downstream _test.go against staged contracts —
#    the gate that would have caught 65ad62b1's fakeStore/SaveMessagesWithToolCalls)
echo -e "\e[34m[2/20]\e[0m Test-compiling clean consumer packages..."
"$SCRIPT_DIR/pre-commit-consumer-tests" || exit 1

# 3. Deferred item check (findings docs have resolution plans)
echo -e "\e[34m[3/20]\e[0m Running deferred item validation..."
"$SCRIPT_DIR/pre-commit-deferred" || exit 1

# 4. Mutex I/O analyzer (CLAUDE.md rule: no I/O under lock)
echo -e "\e[34m[4/20]\e[0m Running mutex I/O analyzer..."
"$SCRIPT_DIR/pre-commit-mutexio" || exit 1

# 5. Staticcheck U1000 (unused code detection)
echo -e "\e[34m[5/20]\e[0m Running unused code check..."
"$SCRIPT_DIR/pre-commit-u1000" || exit 1

# 6. go vet (common Go bugs)
echo -e "\e[34m[6/20]\e[0m Running go vet..."
"$SCRIPT_DIR/pre-commit-vet" || exit 1

# 7. Setter nil-safety (typed-nil interface guard)
echo -e "\e[34m[7/20]\e[0m Verifying setter nil-safety..."
"$SCRIPT_DIR/pre-commit-setters"

# 8. Selflock analyzer (self-deadlocking locks)
echo -e "\e[34m[8/20]\e[0m Checking for self-deadlocking locks..."
"$SCRIPT_DIR/pre-commit-selflock" || exit 1

# 9. gosec security scan (if installed)
echo -e "\e[34m[9/20]\e[0m Running security scan..."
"$SCRIPT_DIR/pre-commit-gosec" || exit 1

# 10. Error handling patterns
echo -e "\e[34m[10/20]\e[0m Checking error handling patterns..."
"$SCRIPT_DIR/pre-commit-errors" || exit 1

# 11. Predictable ID detection (use pkg/id.Generate, not time.Now().UnixNano())
echo -e "\e[34m[11/20]\e[0m Checking for predictable ID generation..."
"$SCRIPT_DIR/pre-commit-predictable-ids" || exit 1

# 12. SQLite pragma check (WAL + busy_timeout required)
echo -e "\e[34m[12/20]\e[0m Checking SQLite pragma compliance..."
"$SCRIPT_DIR/pre-commit-sqlite-pragmas" || exit 1

# 13. Channel close-then-nil detection (use sync.Once instead)
echo -e "\e[34m[13/20]\e[0m Checking for close-then-nil channel pattern..."
"$SCRIPT_DIR/pre-commit-channel-nilafterclose" || exit 1

# 14. Concurrency annotations (informational, does not block)
echo -e "\e[34m[14/20]\e[0m Checking concurrency annotations..."
"$SCRIPT_DIR/pre-commit-concurrency" || true

# 15. Mutation testing (report only, does not block)
echo -e "\e[34m[15/20]\e[0m Checking mutation test coverage..."
"$SCRIPT_DIR/pre-commit-mutation" || true

# 16. Feature documentation check
echo -e "\e[34m[16/20]\e[0m Verifying feature documentation..."
"$SCRIPT_DIR/pre-commit-feature-docs" || exit 1

# 17. Non-English character check (CJK/Hangul/fullwidth in staged text files)
echo -e "\e[34m[17/20]\e[0m Checking for non-English characters..."
"$SCRIPT_DIR/pre-commit-ascii" || exit 1

# 18. Dart formatting check (staged ui/flutter_ui Dart files)
echo -e "\e[34m[18/20]\e[0m Checking Dart formatting (ui/flutter_ui)..."
"$SCRIPT_DIR/pre-commit-dart-format" || exit 1

# 19. e2e enforcement (affected suites + new-feature coverage rule)
echo -e "\e[34m[19/20]\e[0m Checking e2e coverage (affected suites)..."
"$SCRIPT_DIR/pre-commit-e2e" || exit 1

# 20. deadcode reachability (blocks NEW unwired functions vs baseline)
echo -e "\e[34m[20/20]\e[0m Checking code reachability (deadcode gate)..."
"$SCRIPT_DIR/pre-commit-deadcode" || exit 1

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo -e "\e[32m✅ All pre-commit checks passed\e[0m"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

exit 0
