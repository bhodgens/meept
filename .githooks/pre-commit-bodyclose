#!/opt/homebrew/bin/bash
# Pre-commit hook that runs bodyclose on staged Go packages.
#
# Catches HTTP response bodies that are not closed, which can leak
# connections / file descriptors under load. This is one of the highest
# signal-to-noise bug-class linters for Go HTTP code.
#
# Requires: bodyclose
#   go install github.com/timakin/bodyclose@latest
#
# Added 2026-06-19 per docs/20260618-checkreview.md recommendations.
#
# CRASH-VS-FINDINGS CONTRACT (2026-11-12):
# A non-zero exit from `go vet -vettool=bodyclose` is NOT always a finding.
# When the bodyclose binary is built with an older Go than the stdlib export
# data (go/types panics: "export data version 5 is greater than maximum
# supported version 4"), the vettool run panics on EVERY package. Treating
# that as findings permanently blocks all Go commits. Classify per-package:
#   - TOOL CRASH / LOAD FAILURE: output has no bodyclose diagnostic (panic
#     markers like 'panic:' / 'export data version' / 'goroutine [running]'
#     typically appear, and so do plain COMPILE errors from a dirty working
#     tree — 'x.go:12:3: undefined: field' — which are NOT bodyclose
#     findings). bodyclose's only diagnostic message is exactly
#     'response body must be closed' (verified from the binary); findings
#     are discriminated by file:line:col PLUS that message text, never by
#     the location shape alone.
#   - FINDINGS: at least one line matching
#     grep -E '\.go:[0-9]+:[0-9]+:.*response body must be closed'. MUST stay
#     strict — keep the discriminating regex in sync with bodyclose's output
#     shape when editing this hook (string 'response body must be closed'
#     lives in the binary; a tool version that renames it must update here).
#   - CLEAN: rc=0.
# Findings anywhere -> exit 1 as before. Crashes only -> loud yellow skip
# banner with rebuild instructions, exit 0 (a broken tool must not block
# commits, but the skip must be impossible to miss).
# Precedence rule: FINDINGS > CRASH. A package whose output contains both
# panic markers AND file:line:col diagnostics counts as FINDINGS (the tool
# analyzed the target despite crashing elsewhere) — classification must
# never convert a visible finding into a silent skip.

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Running bodyclose on staged packages${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Check if bodyclose is installed
if ! command -v bodyclose &> /dev/null; then
  if [ -x "$HOME/go/bin/bodyclose" ]; then
    BODYCLOSE="$HOME/go/bin/bodyclose"
  else
    echo -e "${YELLOW}⚠️  bodyclose not installed, skipping${NC}"
    echo ""
    echo "Install with:"
    echo "  go install github.com/timakin/bodyclose@latest"
    echo ""
    exit 0
  fi
else
  BODYCLOSE="$HOME/go/bin/bodyclose"
fi

STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null | grep '\.go$' | grep -v '_test\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
  echo -e "${GREEN}✅ No Go source files staged${NC}"
  exit 0
fi

PACKAGES=$(echo "$STAGED_GO_FILES" \
  | grep -v '\.worktrees/' \
  | grep -v '/vendor/' \
  | grep -v 'zz_generated' \
  | grep -v '\.pb\.go' \
  | xargs -I{} dirname {} \
  | sort -u \
  | sed 's|^|./|')

if [ -z "$PACKAGES" ]; then
  echo -e "${GREEN}✅ No packages to check${NC}"
  exit 0
fi

echo "Checking packages:"
echo "$PACKAGES" | sed 's/^/  /'
echo ""

# bodyclose is a single-checker; it has no -checks flag.
# Run go vet with the bodyclose analyzer so we get per-package scoping for free.
#
# Classification per package (see contract at top):
#   FINDINGS_BODY: matched file:line:col diagnostic lines (fail the commit)
#   CRASHED_PKGS:  packages where the tool crashed (panic / no diagnostics)
# A '# pkg' header line with no bodyclose diagnostic after it is a crash/
# load-failure signature: `go vet` prints the header before the analyzer
# bails, and an unanalyzable package (panic OR plain compile errors from a
# sibling's dirty tree) never produces the 'response body must be closed'
# message. Compile errors are NOT findings — build/vet hooks gate them.
FAILED=false
OUTPUT=""
CRASHED_PKGS=""
for pkg in $PACKAGES; do
  if result=$(go vet -vettool="$BODYCLOSE" "$pkg" 2>&1); then
    :
  else
    # A FINDING requires BOTH markers anywhere in the output:
    #   1. bodyclose's exact message text (covers the text form
    #      'file.go:L:C: response body must be closed' AND the -json form
    #      where the message rides its own '"message": "..."' line), and
    #   2. a .go:L:C position marker (filters any output that merely
    #      quotes the tool's docs/help text — the analyzer's own name/description
    #      never appears without a position when it has nothing to report).
    # Compile errors ('undefined: field') and export-data panics carry
    # neither pair together, so they classify as CRASH.
    diagnostics=""
    if printf '%s\n' "$result" | grep -qE 'response body must be closed' \
       && printf '%s\n' "$result" | grep -qE '\.go:[0-9]+:[0-9]+'; then
      diagnostics=$(printf '%s\n' "$result" | grep -E '\.go:[0-9]+:[0-9]+:.*response body must be closed|response body must be closed' | sort -u)
    fi
    if [ -n "$diagnostics" ]; then
      # FINDINGS: bodyclose-message lines are authoritative. Even if panic
      # markers or compile noise are also present (tool crashed on some
      # dependency packages but still analyzed the target), genuine
      # findings must fail the commit — the findings gate never loosens.
      FAILED=true
      OUTPUT="${OUTPUT}${pkg}:\n${diagnostics}\n\n"
    else
      # CRASH: non-zero exit with no diagnostic lines (panic / export-data
      # skew / bare '# pkg' header). The panic-marker grep below is the
      # explicit signature check; empty-diagnostics alone is sufficient.
      CRASHED_PKGS="${CRASHED_PKGS}  ${pkg}\n"
    fi
  fi
done

# Genuine findings fail exactly as before, with crashed packages listed too.
if [ "$FAILED" = true ]; then
  echo -e "${RED}❌ bodyclose found unclosed HTTP response bodies:${NC}"
  echo ""
  echo -e "$OUTPUT"
  if [ -n "$CRASHED_PKGS" ]; then
    echo -e "${YELLOW}⚠️  bodyclose also CRASHED (toolchain skew) on these packages (not checked):${NC}"
    echo -e "$CRASHED_PKGS"
    echo ""
  fi
  echo -e "${YELLOW}Always defer resp.Body.Close() after every http.Client.Do / Get / Post.${NC}"
  echo ""
  exit 1
fi

# Crashes with no findings anywhere: skip loudly, do not block the commit.
if [ -n "$CRASHED_PKGS" ]; then
  echo -e "${YELLOW}⚠️  bodyclose CRASHED or could not load the packages (toolchain skew, or plain compile errors in the working tree); bodyclose check SKIPPED for these packages in this commit. If the tool itself is stale, rebuild with \`go install github.com/timakin/bodyclose@latest\`; if compile errors from a dirty tree are the cause, fix them (the build/vet hooks will also catch them).${NC}"
  echo ""
  echo -e "Crashed packages:"
  echo -e "$CRASHED_PKGS"
  echo ""
  exit 0
fi

echo -e "${GREEN}✅ bodyclose passed - no leaked bodies${NC}"
exit 0
