#!/opt/homebrew/bin/bash
# Pre-commit hook that runs bodyclose on staged Go packages.
#
# Catches HTTP response bodies that are not closed, which can leak
# connections / file descriptors under load. This is one of the highest
# signal-to-noise bug-class linters for Go HTTP code.
#
# Requires: bodyclose
#   go install github.com/timakin/bodyclose@latest
#
# Added 2026-06-19 per docs/20260618-checkreview.md recommendations.

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Running bodyclose on staged packages${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Check if bodyclose is installed
if ! command -v bodyclose &> /dev/null; then
  if [ -x "$HOME/go/bin/bodyclose" ]; then
    BODYCLOSE="$HOME/go/bin/bodyclose"
  else
    echo -e "${YELLOW}⚠️  bodyclose not installed, skipping${NC}"
    echo ""
    echo "Install with:"
    echo "  go install github.com/timakin/bodyclose@latest"
    echo ""
    exit 0
  fi
else
  BODYCLOSE="$HOME/go/bin/bodyclose"
fi

STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null | grep '\.go$' | grep -v '_test\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
  echo -e "${GREEN}✅ No Go source files staged${NC}"
  exit 0
fi

PACKAGES=$(echo "$STAGED_GO_FILES" \
  | grep -v '\.worktrees/' \
  | grep -v '/vendor/' \
  | grep -v 'zz_generated' \
  | grep -v '\.pb\.go' \
  | xargs -I{} dirname {} \
  | sort -u \
  | sed 's|^|./|')

if [ -z "$PACKAGES" ]; then
  echo -e "${GREEN}✅ No packages to check${NC}"
  exit 0
fi

echo "Checking packages:"
echo "$PACKAGES" | sed 's/^/  /'
echo ""

# bodyclose is a single-checker; it has no -checks flag.
# Run go vet with the bodyclose analyzer so we get per-package scoping for free.
FAILED=false
OUTPUT=""
for pkg in $PACKAGES; do
  if result=$(go vet -vettool="$BODYCLOSE" "$pkg" 2>&1); then
    :
  else
    FAILED=true
    OUTPUT="${OUTPUT}${pkg}:\n${result}\n\n"
  fi
done

if [ "$FAILED" = true ]; then
  echo -e "${RED}❌ bodyclose found unclosed HTTP response bodies:${NC}"
  echo ""
  echo -e "$OUTPUT"
  echo -e "${YELLOW}Always defer resp.Body.Close() after every http.Client.Do / Get / Post.${NC}"
  echo ""
  exit 1
fi

echo -e "${GREEN}✅ bodyclose passed - no leaked bodies${NC}"
exit 0
