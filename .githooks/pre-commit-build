#!/usr/bin/env bash
# Pre-commit hook that runs `go build` on staged Go packages.
#
# Catches compile errors before they reach CI — particularly important for
# catching in-progress feature work that breaks the rest of the tree (e.g.
# new struct fields that other packages depend on). Sub-2s typically.
#
# Compatibility: needs bash >= 3.2; the interpreter is whatever `bash` resolves
# to on PATH, so the same file runs on macOS (/bin/bash 3.2 or Homebrew bash 5)
# and on a Linux runner (bash 5). No mapfile, no associative arrays — same
# constraint as pre-commit-mutexio. The shebang used to be hard-coded to
# /opt/homebrew/bin/bash, which made the CI "Pre-commit Hooks" job unable to
# exec this hook at all on Linux (audit F100).
#
# Added 2026-06-19 per docs/20260618-checkreview.md recommendations.

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Running go build on staged packages${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null | grep '\.go$' | grep -v '_test\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
  echo -e "${GREEN}✅ No Go source files staged${NC}"
  exit 0
fi

# Package dirs with staged changes, as ./import paths (newline list).
STAGED_PKGS=$(printf '%s\n' "$STAGED_GO_FILES" | xargs -I{} dirname {} | sort -u | sed 's|^|./|')

# Snapshot untracked paths before any build runs; compared against the same
# list at the end so a build that writes an executable into the tree is caught
# instead of merely hidden by .gitignore (audit F25).
STATUS_BEFORE="$(git status --porcelain --untracked-files=all 2>/dev/null || true)"

# Root-level entries (untracked AND gitignored). Required because the F25
# artifact class — a built /meept, /meept-daemon, /meept-lite — is GITIGNORED,
# so a plain `git status` never lists it, while the old `^\?\? [^/]+$` filter
# could not see a root-level DIRECTORY either: `--untracked-files=all` expands
# directories into per-file `?? dir/file` entries, none of which is a bare root
# name. That is why the assertion was simultaneously blind to the very artifact
# it existed for (b) and hostile to any unrelated root file that appeared in
# the window, e.g. coverage.out from the documented
# `go test -coverprofile=coverage.out` (a).
# `--untracked-files=normal` collapses a directory to `name/`, and
# `--ignored=matching` collapses ignored directories the same way, so this
# stays a cheap tree walk (~70ms here) instead of stat-ing every ignored file.
root_entries() {
  git status --porcelain --untracked-files=normal --ignored=matching 2>/dev/null \
    | grep -E '^(\?\?|!!) ' \
    | sed -e 's/^.. //' -e 's|/.*$||' \
    | sort -u
}

# Size+mtime of the root-level binaries a build can write. A stale /meept-daemon
# already sitting in the tree (this repo has them) is invisible to a
# new-entry comparison even though a bare `go build` CLOBBERING it is the same
# accident — and `git status` reports nothing at all for an ignored file that
# changed. Only these known names are fingerprinted, so no other session's file
# can make this fire.
#
# LIMITS, both reproduced in /tmp against this function:
#   * a same-size, same-second clobber is NOT seen. mtime granularity is one
#     second and a rebuild of identical source yields an identical size, so
#     rewriting one of these binaries with the same byte count inside the same
#     second leaves the snapshot byte-identical. This is a heuristic for the
#     real case (a bare `go build` of a package tree takes longer than a
#     second), not an exact change detector — the `-o /dev/null` builds above
#     are what actually keep the tree clean;
#   * the names are NOT emitted in the byte order the fixed-name list would give
#     (`meept meept-daemon meept-lite llmdoc` is not sorted, and `*.test` is
#     appended after it), while `comm -13` below requires sorted input. `sort`
#     makes the comparison independent of the emission order (BSD comm
#     diagnoses the disorder on stderr: "file 2 is not in sorted order").
root_artifact_state() {
  local n
  {
    for n in meept meept-daemon meept-lite llmdoc; do
      [ -e "$n" ] || continue
      printf '%s %s %s\n' "$n" "$(wc -c <"$n" | tr -d ' ')" "$(date -r "$n" +%s 2>/dev/null || echo 0)"
    done
    for n in *.test; do
      [ -e "$n" ] || continue
      printf '%s %s %s\n' "$n" "$(wc -c <"$n" | tr -d ' ')" "$(date -r "$n" +%s 2>/dev/null || echo 0)"
    done
  } | sort
}
ROOT_BEFORE="$(root_entries)"
ARTIFACT_BEFORE="$(root_artifact_state)"

echo "Staged packages:"
printf '  %s\n' $STAGED_PKGS
echo ""

# Packages whose working-tree files differ from HEAD outside what is staged:
# these contain other sessions' WIP and are flagged when building from the
# working tree.
DIRTY_PKGS=$(git diff --name-only HEAD | sort -u | xargs -I{} dirname {} | sort -u | sed 's|^|./|')

for pkg in $STAGED_PKGS; do
  if printf '%s\n' "$DIRTY_PKGS" | grep -Fxq "$pkg"; then
    echo -e "${YELLOW}⚠ $pkg has unstaged WIP — vetting via staged-only build may be imprecise; building anyway${NC}"
  fi
done

# 1) Direct build of each staged package from its WORKING TREE state. The
#    worktree equals the index for fully-staged paths, so this validates the
#    exact content being committed. Errors here always fail the hook: they
#    belong to code being committed right now (or conflict with foreign WIP,
#    which needs human attention either way).
# magefiles/*.go carry `//go:build mage` and declare no func main (mage emits
# it), so neither a plain build ("build constraints exclude all Go files") nor
# a tagged one ("function main is undeclared") can succeed there. `go vet
# -tags mage` type-checks the same source without needing an entry point. No
# other package in the module uses the mage tag.
BUILD_FAILED=""
BUILD_PKGS="$STAGED_PKGS"
if printf '%s\n' "$STAGED_PKGS" | grep -qx "./magefiles"; then
  if ! PKG_OUTPUT=$(go vet -tags mage ./magefiles 2>&1); then
    BUILD_FAILED="${BUILD_FAILED}./magefiles (go vet -tags mage)
${PKG_OUTPUT}
"
  fi
  BUILD_PKGS=$(printf '%s\n' "$STAGED_PKGS" | grep -vx "./magefiles" || true)
fi

# Build each remaining staged package on its own with -o /dev/null. A plain
# `go build` writes an executable for a `package main` (littering the tree, or
# colliding with a same-named directory such as magefiles), and -o accepts
# only one package plus one output path, so the loop is the portable form.
for pkg in $BUILD_PKGS; do
  if ! PKG_OUTPUT=$(go build -o /dev/null "$pkg" 2>&1); then
    BUILD_FAILED="${BUILD_FAILED}${pkg}
${PKG_OUTPUT}
"
  fi
done
if [ -n "$BUILD_FAILED" ]; then
  echo -e "${RED}❌ go build failed (staged packages):${NC}"
  echo ""
  echo "$BUILD_FAILED"
  exit 1
fi

# 2) Downstream importers: reverse-dependency closure of the staged packages,
#    computed from export data so it stays fast (~1s). Dirty non-staged
#    packages are EXCLUDED — a foreign session's half-written file must not
#    block this commit when the commit itself is self-consistent.
if command -v go >/dev/null && go list ./... >/dev/null 2>&1; then
  DOWNSTREAM=""
  while IFS= read -r pkg; do
    [ -z "$pkg" ] && continue
    case "
$STAGED_PKGS
" in
      *"
$pkg
"*) continue ;;
    esac
    imports=$(go list -f '{{join .Imports "\n"}}' "$pkg" 2>/dev/null || true)
    for s in $STAGED_PKGS; do
      if echo "$imports" | grep -qx "${s#./}"; then
        # Only build if this downstream package is clean vs HEAD.
        rel="${pkg#github.com/caimlas/meept/}"
        if git diff --quiet HEAD -- "$rel" 2>/dev/null; then
          DOWNSTREAM="$DOWNSTREAM$pkg
"
        fi
        break
      fi
    done
  done <<EOF
$(go list ./... 2>/dev/null)
EOF

  if [ -n "$DOWNSTREAM" ]; then
    echo "Downstream importers (clean):"
    printf '%s' "$DOWNSTREAM" | sed 's/^/  /'
    echo ""
    # Build each importer on its own with -o /dev/null. A bare
    # `go build <pkg>` writes the executable into the CURRENT DIRECTORY when the
    # set is a single `package main` — an 86 MB ./meept-daemon in the repo root,
    # invisible to `git status` because .gitignore hides it (audit F25). -o
    # takes one package plus one output path, so the loop is the portable form.
    DOWN_FAILED=""
    while IFS= read -r pkg; do
      [ -z "$pkg" ] && continue
      if ! OUTPUT=$(go build -o /dev/null "$pkg" 2>&1); then
        DOWN_FAILED="${DOWN_FAILED}${pkg}
${OUTPUT}
"
      fi
    done <<EOF
$DOWNSTREAM
EOF
    if [ -n "$DOWN_FAILED" ]; then
      echo -e "${RED}❌ go build failed (downstream importers):${NC}"
      echo ""
      echo "$DOWN_FAILED"
      echo ""
      exit 1
    fi
  fi
else
  # Fallback: whole-tree build when module listing is unavailable.
  # `go build ./...` writes no executables (Go discards multiple outputs).
  if ! OUTPUT=$(go build ./... 2>&1); then
    echo -e "${RED}❌ go build failed:${NC}"
    echo ""
    echo "$OUTPUT"
    echo ""
    exit 1
  fi
fi

# Nothing above may write into the working tree: an executable lands in the
# CWD (the repo root) when a bare `go build` names exactly one `package main`
# — the F25 artifact class, hidden from `git status` by .gitignore.
#
# Fail only for names a BUILD can create: the root-level binaries .gitignore
# hides (/meept, /meept-daemon, /meept-lite, /llmdoc), `go test -c` outputs, and
# any other root-level executable this module's own `package main` directories
# can produce. That last class is why the old closed list was wrong: a bare
# `go build ./cmd/gendoc` (no -o) writes /gendoc into the CWD, and cmd/gendoc,
# cmd/artifact-demo and cmd/tmp-verify are NOT gitignored, so the old case
# statement only warned about the very artifact this check exists for.
# Every other new root-level entry is another session's file — coverage.out from
# the documented `go test -coverprofile=coverage.out`, a scratch note — and is
# reported without blocking. Deeper untracked paths never block either.
STATUS_AFTER="$(git status --porcelain --untracked-files=all 2>/dev/null || true)"
ROOT_AFTER="$(root_entries)"
ARTIFACT_AFTER="$(root_artifact_state)"
NEW_UNTRACKED="$(printf '%s\n' "$STATUS_BEFORE" | grep '^??' | sort || true)"
NEW_UNTRACKED_AFTER="$(printf '%s\n' "$STATUS_AFTER" | grep '^??' | sort || true)"
NEW_ROOT="$(comm -13 <(printf '%s\n' "$ROOT_BEFORE") <(printf '%s\n' "$ROOT_AFTER") || true)"
# A known artifact that existed before and now differs (size or mtime) was
# written by this build just as surely as a new one: F25 twice over.
CHANGED_ARTIFACTS="$(comm -13 <(printf '%s\n' "$ARTIFACT_BEFORE") <(printf '%s\n' "$ARTIFACT_AFTER") | awk '{print $1}' || true)"
NEW_ROOT="$(printf '%s\n%s\n' "$NEW_ROOT" "$CHANGED_ARTIFACTS" | grep -v '^$' | sort -u || true)"

# Names a bare `go build <pkg>` can drop into the repo root: the basename of
# every `package main` directory in the module (cmd/gendoc -> ./gendoc,
# tools/analyzers/selflock -> ./selflock). Derived rather than hardcoded, so a
# new cmd/<name> is covered the day it lands. Only computed when a new root
# entry actually needs classifying (the common case pays nothing); `</dev/null`
# keeps a `go list` inside the read-from-heredoc loop from touching its stdin.
BUILD_NAMES=""
BUILD_NAMES_DONE=0
build_artifact_names() {
  [ "$BUILD_NAMES_DONE" = "1" ] && return 0
  BUILD_NAMES_DONE=1
  if command -v go >/dev/null 2>&1; then
    BUILD_NAMES="$(go list -e -f '{{if eq .Name "main"}}{{.Dir}}{{end}}' ./... 2>/dev/null </dev/null \
      | sed -e 's|.*/||' -e '/^$/d' | sort -u || true)"
  fi
}

BLOCKED=""
OTHER=""
while IFS= read -r name; do
  [ -z "$name" ] && continue
  case "$name" in
    meept|meept-daemon|meept-lite|llmdoc|*.test)
      BLOCKED="${BLOCKED}${name}
" ;;
    *)
      build_artifact_names
      if [ -n "$BUILD_NAMES" ] && printf '%s\n' "$BUILD_NAMES" | grep -Fxq "$name"; then
        BLOCKED="${BLOCKED}${name}
"
      else
        OTHER="${OTHER}${name}
"
      fi
      ;;
  esac
done <<EOF
$NEW_ROOT
EOF
if [ -n "$BLOCKED" ]; then
  echo -e "${RED}❌ go build wrote new build artifact(s) into the repo root:${NC}"
  echo ""
  printf '%s' "$BLOCKED" | sed 's/^/  /'
  echo ""
  echo -e "${YELLOW}Build into /dev/null or a temp dir (never the repo root).${NC}"
  echo -e "${YELLOW}A bare 'go build ./cmd/<dir>' writes ./<dir>; that is the class this blocks.${NC}"
  echo -e "${YELLOW}If another session created those files during this run, re-run the commit.${NC}"
  echo ""
  exit 1
fi
if [ -n "$OTHER" ]; then
  echo -e "${YELLOW}note: other new root-level path(s) appeared while building (not build artifacts — not blocking):${NC}"
  printf '%s' "$OTHER" | sed 's/^/  /'
  echo ""
fi
if [ "$NEW_UNTRACKED" != "$NEW_UNTRACKED_AFTER" ]; then
  NESTED_NEW="$(comm -13 <(printf '%s\n' "$NEW_UNTRACKED") <(printf '%s\n' "$NEW_UNTRACKED_AFTER") | grep '/' || true)"
  if [ -n "$NESTED_NEW" ]; then
    echo -e "${YELLOW}note: untracked path(s) appeared under the tree while building (not root-level, not blocking):${NC}"
    printf '%s\n' "$NESTED_NEW" | sed 's/^/  /'
    echo ""
  fi
fi

echo -e "${GREEN}✅ go build passed — staged packages + clean downstream importers compile${NC}"
exit 0
