#!/usr/bin/env bash
# pre-commit-dart-format — block commits that stage unformatted Dart files.
#
# The Flutter tree (ui/flutter_ui) is kept dart-format clean. `make lint-ci`
# enforces this repo-wide via the fmt-check-gui target; this hook enforces it
# on STAGED files only, so a commit cannot introduce unformatted Dart while an
# unrelated unformatted file elsewhere in the tree does not block you.
#
# What is checked: the INDEX BLOB of every staged file matching
# ui/flutter_ui/**/*.dart (added, copied, modified, renamed) — i.e. the exact
# bytes that land in the commit. The working-tree copy is NOT what is checked:
# formatting the working tree after staging used to make this hook pass while
# the commit carried an unformatted blob (audit F26). The staged path list is
# kept for messages.
#
# Policy when the Dart SDK is missing (audit F90 — this hook and
# `make fmt-check-gui` now agree):
#   * Dart files to check + no dart binary  -> FAIL (exit 1), never a silent
#     pass. A machine that cannot run the formatter cannot certify the Flutter
#     tree; `git commit --no-verify` is the explicit escape hatch.
#   * Nothing to check -> PASS (exit 0), printed.
#
# Usage:
#   .githooks/pre-commit-dart-format            # staged blobs (hook mode)
#   .githooks/pre-commit-dart-format <file...>  # check specific files on disk
#
# Install: called from .githooks/pre-commit (step 17). Needs bash >= 3.2; the
# interpreter is whatever `bash` resolves to on PATH (macOS 3.2/5, Linux 5) —
# the hard-coded /opt/homebrew/bin/bash shebang made the CI hook job unable to
# exec this file on Linux (audit F100).

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

DART_ROOT="ui/flutter_ui"

# Resolve the dart binary: PATH first, then the dart bundled with Flutter
# (flutter/bin/cache/dart-sdk/bin/dart). Mirrors the Makefile DART variable.
DART_BIN=""
if command -v dart >/dev/null 2>&1; then
  DART_BIN="$(command -v dart)"
fi
if [ -z "$DART_BIN" ] && command -v flutter >/dev/null 2>&1; then
  FLUTTER_BIN="$(command -v flutter)"
  RP="$(readlink -f "$FLUTTER_BIN" 2>/dev/null || echo "$FLUTTER_BIN")"
  FLUTTER_ROOT="$(cd "$(dirname "$RP")/.." 2>/dev/null && pwd || true)"
  CAND="$FLUTTER_ROOT/bin/cache/dart-sdk/bin/dart"
  [ -x "$CAND" ] && DART_BIN="$CAND"
fi

# Collect candidate files: explicit args win, otherwise staged Dart files.
if [ "$#" -gt 0 ]; then
  MODE="explicit"
  FILES=$(printf '%s\n' "$@")
else
  MODE="staged"
  FILES=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null \
            | grep -E "^${DART_ROOT}/.*\.dart$" || true)
fi

# Materialize the content to be checked into a temp dir, and keep the
# corresponding staged/original path alongside it:
#   paths/<n>  the path as the user knows it (for messages)
#   blobs/<n>.dart  the content to format
# In staged mode the content comes from the index (`git show ":$f"`), so the
# check sees exactly what the commit will contain.
TMP_DART="$(mktemp -d "${TMPDIR:-/tmp}/meept-dartfmt.XXXXXX")"
trap 'rm -rf "$TMP_DART"' EXIT
mkdir -p "$TMP_DART/paths" "$TMP_DART/blobs"

N=0
while IFS= read -r f; do
  [ -z "$f" ] && continue
  if [ "$MODE" = "staged" ]; then
    if ! git show ":$f" >"$TMP_DART/blob.tmp" 2>/dev/null; then
      # Not in the index (e.g. a rename's old path) — fall back to disk.
      if [ -f "$f" ]; then
        cp "$f" "$TMP_DART/blob.tmp"
      else
        continue
      fi
    fi
  else
    [ -f "$f" ] || continue
    cp "$f" "$TMP_DART/blob.tmp"
  fi
  N=$((N + 1))
  printf '%s\n' "$f" >"$TMP_DART/paths/$N"
  mv "$TMP_DART/blob.tmp" "$TMP_DART/blobs/$N.dart"
done <<< "$FILES"

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Dart formatting check (${DART_ROOT})${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

if [ "$N" -eq 0 ]; then
  if [ "$MODE" = "staged" ]; then
    echo -e "${GREEN}PASS: no staged Dart files under ${DART_ROOT} — nothing to check.${NC}"
  else
    echo -e "${GREEN}PASS: no existing Dart files given to check.${NC}"
  fi
  exit 0
fi

if [ -z "$DART_BIN" ]; then
  echo -e "${RED}FAIL: dart not found (nothing on PATH, no Flutter SDK dart).${NC}"
  echo -e "${RED}      ${N} file(s) under ${DART_ROOT} need a formatting verdict.${NC}"
  echo -e "${YELLOW}Policy: this hook and 'make fmt-check-gui' (in 'make lint-ci') both${NC}"
  echo -e "${YELLOW}refuse to pass when the formatter is unavailable — an unverifiable${NC}"
  echo -e "${YELLOW}tree is not a clean tree. Install Flutter or add dart to PATH,${NC}"
  echo -e "${YELLOW}run 'make fmt-gui'/'make fmt-check-gui', then re-commit.${NC}"
  echo -e "${YELLOW}(git commit --no-verify is the explicit escape hatch.)${NC}"
  exit 1
fi

if [ "$MODE" = "staged" ]; then
  echo "Checking ${N} staged file(s) from the INDEX (what gets committed):"
else
  echo "Checking ${N} file(s) on disk:"
fi
i=0
while [ "$i" -lt "$N" ]; do
  i=$((i + 1))
  echo "  $(cat "$TMP_DART/paths/$i")"
done
echo ""

# Format each blob and report the STAGED path (never the temp blob path).
BAD=""
BAD_DETAIL=""
i=0
while [ "$i" -lt "$N" ]; do
  i=$((i + 1))
  path="$(cat "$TMP_DART/paths/$i")"
  blob="$TMP_DART/blobs/$i.dart"
  set +e
  OUT="$("$DART_BIN" format --output=none --set-exit-if-changed "$blob" 2>&1)"
  STATUS=$?
  set -e
  if [ "$STATUS" -ne 0 ]; then
    BAD="${BAD}${path}
"
    # Report the staged path, never the temp blob path.
    BAD_DETAIL="${BAD_DETAIL}${path}:
${OUT//$blob/$path}
"
  fi
done

if [ -n "$BAD" ]; then
  if [ "$MODE" = "staged" ]; then
    echo -e "${RED}FAIL: staged Dart file(s) are not formatted (index blob, not the working tree):${NC}"
  else
    echo -e "${RED}FAIL: Dart file(s) are not formatted:${NC}"
  fi
  printf '%s' "$BAD" | sed 's/^/  /'
  echo ""
  echo -e "${YELLOW}Run 'make fmt-gui' (or: dart format ${DART_ROOT}), then re-stage and commit.${NC}"
  printf '%s' "$BAD_DETAIL" | sed 's/^/  /'
  exit 1
fi

echo -e "${GREEN}PASS: all ${N} Dart file(s) checked are formatted.${NC}"
exit 0
