#!/bin/bash
# Pre-commit hook: deadcode reachability gate (blocks NEW unwired functions)
#
# Runs golang.org/x/tools/cmd/deadcode on ALL FIVE production binaries
# (cmd/meept-daemon, cmd/meept, cmd/meept-lite, cmd/meept-classifier-test,
# tools/bridges-eval) in TWO modes:
#
#   1. WITH -test:   intersects the per-binary unreachable sets and diffs
#      against .githooks/deadcode-baseline.txt (the historical baseline).
#   2. WITHOUT -test: same intersection/diff against
#      .githooks/deadcode-baseline-notest.txt (the no-test baseline).
#
# The commit is blocked if a function appears as NEW (absent from the
# baseline) in EITHER mode. Mode 2 is the strict pass: -test makes a
# function whose only caller is its own unit test look WIRED, which is
# exactly the "implemented with tests but never wired" failure shape this
# gate exists to catch. Without -test such functions surface as unwired.
#
# Why the intersection (not the union): a function wired in one binary but
# merely LINKED (never called) in another is live code. Union baselining
# counted such functions as dead — 88% of the pre-campaign stock (13,610
# entries shrank to a 1,452 true intersection in the 2026-11-09 triage;
# adding the three smaller mains shrank it further to ~590). Only the
# both/ALL-binaries intersection is genuinely unwired code.
#
# Why a baseline: the repo already carries thousands of unreachable
# functions. A "must be empty" gate would block every commit forever.
# New-code-only ratchets the count down instead of up; re-baseline
# deliberately when you INTEND to remove or wire dead code (same policy as
# the bench regression baseline in .githooks/README.md).
#
# Line numbers are stripped from the comparison key (path + func name only)
# so pure code motion never produces false new/removed churn.
#
# Usage:
#   .githooks/pre-commit-deadcode               # gate (called from pre-commit)
#   .githooks/pre-commit-deadcode --rebaseline  # regenerate BOTH baselines
#
# Env overrides (testing/CI):
#   MEEPT_DEADCODE_BASELINE=/path/to/file       -test-mode baseline location
#   MEEPT_DEADCODE_BASELINE_NOTEST=/path/to/f   no-test baseline location
#   MEEPT_DEADCODE_MAINS="a b c"                binary targets (space-separated
#                                               go list patterns; default: all
#                                               five production mains)
#   MEEPT_DEADCODE_FULL_TREE=1                  analyze the whole working tree
#                                               against the baselines: skips
#                                               the "no staged Go files ->
#                                               exit 0" early-return so CI
#                                               (fresh checkout, empty index)
#                                               still enforces the ratchet.
#   MEEPT_DEADCODE_ALLOW_SKIP=1                 only consulted when the
#                                               deadcode binary is MISSING:
#                                               permits a warning + exit 0.
#                                               Without it a missing binary
#                                               fails the hook (fail-closed);
#                                               when CI=true the binary is
#                                               ALWAYS required.
#
# Requires GOTOOLCHAIN pinned by the caller (pre-commit does this; standalone
# runs pin from go.mod below).

set -euo pipefail

# Byte-order collation for sort/comm (baseline files are C-locale sorted;
# locale-aware sort produces a different order and comm fails on it).
export LC_ALL=C

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

# Pin the toolchain deadcode's package loading uses (same rationale as the
# main pre-commit: GOTOOLCHAIN=auto never downgrades and breaks x/tools).
if [ -z "${GOTOOLCHAIN:-}" ] || [ "$GOTOOLCHAIN" = "auto" ]; then
    export GOTOOLCHAIN="$(sed -n 's/^toolchain[[:space:]]//p' "$PWD/go.mod" | head -1)"
fi
if [ -z "${GOTOOLCHAIN:-}" ]; then
    export GOTOOLCHAIN="$(sed -n 's/^go[[:space:]]//p' "$PWD/go.mod" | head -1)"
fi

REBASELINE=0
if [ "${1:-}" = "--rebaseline" ]; then
    REBASELINE=1
fi

FULL_TREE="${MEEPT_DEADCODE_FULL_TREE:-0}"

BASELINE="${MEEPT_DEADCODE_BASELINE:-$PWD/.githooks/deadcode-baseline.txt}"
BASELINE_NOTEST="${MEEPT_DEADCODE_BASELINE_NOTEST:-$PWD/.githooks/deadcode-baseline-notest.txt}"

# Locate the deadcode binary. A missing binary FAILS the gate: the whole
# point is deterministic enforcement, and a silent skip on a machine
# without the tool is how unwired code lands. The only escape hatch is an
# explicit opt-out (MEEPT_DEADCODE_ALLOW_SKIP=1), and never on CI.
DEADCODE_BIN=""
if command -v deadcode &>/dev/null; then
    DEADCODE_BIN="$(command -v deadcode)"
elif [ -x "$HOME/go/bin/deadcode" ]; then
    DEADCODE_BIN="$HOME/go/bin/deadcode"
fi
if [ -z "$DEADCODE_BIN" ]; then
    if [ "${CI:-}" = "true" ]; then
        echo -e "${RED}✗ deadcode not installed — FAILING on CI (no skip allowed)${NC}"
        echo "   Install with: go install golang.org/x/tools/cmd/deadcode@v0.52.0"
        exit 1
    fi
    if [ "${MEEPT_DEADCODE_ALLOW_SKIP:-0}" = "1" ]; then
        echo -e "${YELLOW}⚠️  deadcode not installed — skip explicitly allowed via MEEPT_DEADCODE_ALLOW_SKIP=1${NC}"
        exit 0
    fi
    echo -e "${RED}✗ deadcode not installed — reachability gate is fail-closed${NC}"
    echo "   Install with: go install golang.org/x/tools/cmd/deadcode@latest"
    echo "   To skip deliberately (local only): MEEPT_DEADCODE_ALLOW_SKIP=1 git commit ..."
    exit 1
fi

# No staged Go files → nothing to check (unless CI/full-tree mode is
# enforcing the whole tree against the baselines).
if [ "$FULL_TREE" != "1" ]; then
    STAGED_GO_FILES=$(git -c color.ui=false -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep '\.go$' || true)
    if [ -z "$STAGED_GO_FILES" ] && [ "$REBASELINE" -eq 0 ]; then
        exit 0
    fi
fi

# Normalize deadcode output to "path: unreachable func: Name" (no line:col —
# those move on every edit and would churn the baseline).
normalize() {
    sed -E 's/:[0-9]+:[0-9]+: unreachable func:/ unreachable func:/'
}

TMPDIR_CURRENT="$(mktemp -d -t meept-deadcode.XXXXXX)"
trap 'rm -rf "$TMPDIR_CURRENT"' EXIT

# Production mains to analyze. Override with MEEPT_DEADCODE_MAINS for
# testing/CI. A function counts as unwired only if unreachable from EVERY
# one of these entry points.
MAINS_DEFAULT="./cmd/meept-daemon ./cmd/meept ./cmd/meept-lite ./cmd/meept-classifier-test ./tools/bridges-eval"
MAINS="${MEEPT_DEADCODE_MAINS:-$MAINS_DEFAULT}"

# analyze_mode <suffix> <extra deadcode flags...>
#
# Runs every binary, intersects the per-binary unreachable sets
# (comm-style incremental intersection — a function is only "currently
# unwired" if unreachable from ALL entry points), and leaves the sorted
# result in $TMPDIR_CURRENT/inter.<suffix>. A deadcode failure means the
# working tree does not typecheck/build — fail closed (pre-commit-build
# runs earlier and should have caught it, so reaching this failure is
# unexpected).
analyze_mode() {
    SUFFIX="$1"
    shift
    FIRST=1
    : > "$TMPDIR_CURRENT/inter.$SUFFIX"
    for MAIN in $MAINS; do
        TAG=$(echo "$MAIN" | tr '/.' '__')
        OUT="$TMPDIR_CURRENT/run$TAG.$SUFFIX"
        if ! "$DEADCODE_BIN" "$@" "$MAIN" > "$OUT" 2>&1; then
            echo -e "${RED}✗ deadcode failed on $MAIN (mode: $SUFFIX — build/typecheck problem?)${NC}"
            head -20 "$OUT"
            exit 1
        fi
        normalize < "$OUT" > "$OUT.norm"
        if [ "$FIRST" -eq 1 ]; then
            LC_ALL=C sort -u "$OUT.norm" > "$TMPDIR_CURRENT/acc"
            FIRST=0
        else
            # Intersection so far: entries present in BOTH the accumulator and
            # this binary's set (comm -12 needs LC_ALL=C-sorted inputs).
            LC_ALL=C sort -u -o "$TMPDIR_CURRENT/acc" "$TMPDIR_CURRENT/acc"
            LC_ALL=C sort -u -o "$OUT.norm" "$OUT.norm"
            comm -12 "$TMPDIR_CURRENT/acc" "$OUT.norm" > "$TMPDIR_CURRENT/acc.next"
            mv "$TMPDIR_CURRENT/acc.next" "$TMPDIR_CURRENT/acc"
        fi
    done
    LC_ALL=C sort -u -o "$TMPDIR_CURRENT/acc" "$TMPDIR_CURRENT/acc"
    cp "$TMPDIR_CURRENT/acc" "$TMPDIR_CURRENT/inter.$SUFFIX"
}

analyze_mode test -test
analyze_mode notest

if [ "$REBASELINE" -eq 1 ]; then
    cp "$TMPDIR_CURRENT/inter.test" "$BASELINE"
    cp "$TMPDIR_CURRENT/inter.notest" "$BASELINE_NOTEST"
    echo -e "${GREEN}✓ deadcode baselines regenerated:${NC}"
    echo "  $BASELINE ($(wc -l < "$BASELINE" | tr -d ' ') unreachable funcs, -test mode)"
    echo "  $BASELINE_NOTEST ($(wc -l < "$BASELINE_NOTEST" | tr -d ' ') unreachable funcs, no-test mode)"
    echo "  Stage them: git add $BASELINE $BASELINE_NOTEST"
    exit 0
fi

for BASE in "$BASELINE" "$BASELINE_NOTEST"; do
    if [ ! -f "$BASE" ]; then
        echo -e "${RED}✗ deadcode baseline missing: $BASE${NC}"
        echo "  Generate it with: .githooks/pre-commit-deadcode --rebaseline"
        exit 1
    fi
done

# report_new <label> <baseline> <current>
# Exits non-zero (via the caller's set -e) when the current set contains
# functions absent from the baseline.
GATE_FAILED=0
report_new() {
    LABEL="$1"
    BASE="$2"
    CUR="$3"
    # New = in the current set but not in the baseline (comm -13).
    NEW_FUNCS=$(comm -13 "$BASE" "$CUR" || true)
    if [ -n "$NEW_FUNCS" ]; then
        NEW_COUNT=$(printf '%s\n' "$NEW_FUNCS" | grep -c . || true)
        echo -e "${RED}✗ deadcode gate ($LABEL): $NEW_COUNT newly unwired function(s) — commit blocked${NC}"
        echo ""
        printf '%s\n' "$NEW_FUNCS" | head -30 | sed 's/^/  /'
        TOTAL_SHOW=$(printf '%s\n' "$NEW_FUNCS" | grep -c .)
        if [ "$TOTAL_SHOW" -gt 30 ]; then
            echo "  ... and $((TOTAL_SHOW - 30)) more"
        fi
        echo ""
        GATE_FAILED=1
    else
        echo -e "${GREEN}✓ deadcode gate ($LABEL): no newly unwired code ($(wc -l < "$CUR" | tr -d ' ') unreachable funcs, at baseline)${NC}"
    fi
}

report_new "-test" "$BASELINE" "$TMPDIR_CURRENT/inter.test"
report_new "no-test" "$BASELINE_NOTEST" "$TMPDIR_CURRENT/inter.notest"

if [ "$GATE_FAILED" -eq 1 ]; then
    echo "  Fix: wire the code into a production call path, remove it, or gate it"
    echo "  behind an existing entry point. A function that only its OWN unit"
    echo "  test calls is NOT wired (the no-test pass exists for exactly this)."
    echo "  If removal/wiring is the intent, re-baseline:"
    echo "    .githooks/pre-commit-deadcode --rebaseline && git add .githooks/deadcode-baseline.txt .githooks/deadcode-baseline-notest.txt"
    exit 1
fi

exit 0
