#!/bin/bash
# Pre-commit hook: deadcode reachability gate (blocks NEW unwired functions)
#
# Runs golang.org/x/tools/cmd/deadcode on ALL FIVE production binaries
# (cmd/meept-daemon, cmd/meept, cmd/meept-lite, cmd/meept-classifier-test,
# tools/bridges-eval) in TWO modes:
#
#   1. WITH -test:   intersects the per-binary unreachable sets and diffs
#      against .githooks/deadcode-baseline.txt (the historical baseline).
#   2. WITHOUT -test: same intersection/diff against
#      .githooks/deadcode-baseline-notest.txt (the no-test baseline).
#
# The commit is blocked if a function appears as NEW (absent from the
# baseline) in EITHER mode. Mode 2 is the strict pass: -test makes a
# function whose only caller is its own unit test look WIRED, which is
# exactly the "implemented with tests but never wired" failure shape this
# gate exists to catch. Without -test such functions surface as unwired.
#
# Why the intersection (not the union): a function wired in one binary but
# merely LINKED (never called) in another is live code. Union baselining
# counted such functions as dead — 88% of the pre-campaign stock (13,610
# entries shrank to a 1,452 true intersection in the 2026-11-09 triage;
# adding the three smaller mains shrank it further to ~590). Only the
# both/ALL-binaries intersection is genuinely unwired code.
#
# Why a baseline: the repo already carries thousands of unreachable
# functions. A "must be empty" gate would block every commit forever.
# New-code-only ratchets the count down instead of up. --rebaseline may
# shrink or stay equal (drop stale lines after wiring). It refuses net
# growth: do not use it to absorb new unwired functions into the allow-list.
#
# Line numbers are stripped from the comparison key (path + func name only)
# so pure code motion never produces false new/removed churn.
#
# Usage:
#   .githooks/pre-commit-deadcode               # gate (called from pre-commit)
#   .githooks/pre-commit-deadcode --rebaseline  # shrink-or-equal only; refuses growth
#
# Env overrides (testing/CI):
#   MEEPT_DEADCODE_BASELINE=/path/to/file       -test-mode baseline location
#   MEEPT_DEADCODE_BASELINE_NOTEST=/path/to/f   no-test baseline location
#   MEEPT_DEADCODE_MAINS="a b c"                binary targets (space-separated
#                                               go list patterns; default: all
#                                               five production mains)
#   MEEPT_DEADCODE_FULL_TREE=1                  analyze the whole working tree
#                                               against the baselines: skips
#                                               the "no staged Go files ->
#                                               exit 0" early-return so CI
#                                               (fresh checkout, empty index)
#                                               still enforces the ratchet.
#   MEEPT_DEADCODE_ALLOW_SKIP=1                 only consulted when the
#                                               deadcode binary is MISSING:
#                                               permits a warning + exit 0.
#                                               Without it a missing binary
#                                               fails the hook (fail-closed);
#                                               when CI=true the binary is
#                                               ALWAYS required.
#   MEEPT_DEADCODE_CACHE=0                      disable the result cache.
#   MEEPT_DEADCODE_CACHE_DIR=/path              cache dir override (default
#                                               <git-dir>/meept-cache).
#   MEEPT_DEADCODE_VERBOSE=1                    print the cache digest on a
#                                               hit too (the full HIT/MISS
#                                               line always prints — the
#                                               selftest seam).
#   MEEPT_DEADCODE_BIN=/path/to/fake            deadcode binary override
#                                               (fixture seam for offline
#                                               selftests; mirrors the PATH
#                                               lookup contract otherwise).
#
# RESULT CACHE (gates-speedup item 5): the 5-main x2-mode analysis costs
# 2-4 minutes and its inputs are the Go source TREE, not the commit. The
# per-mode intersection outputs are cached under <git-dir>/meept-cache
# keyed by a digest of (sha256 of every .go file in the analyzed tree +
# go.mod + go.sum, the baseline file hashes, the mains list, the deadcode
# binary fingerprint). A matching digest reuses the prior intersection
# verbatim; ANY Go content change (staged, unstaged, added, removed)
# changes at least one file hash and misses. Fail-closed rules: only a
# PASSING gate result (both intersections computed, zero NEW-vs-baseline
# functions) is ever written; a gate failure deletes the entry, so a
# failure can never replay as a success and a stale entry can never be
# consulted twice. --rebaseline always does the full analysis. It writes
# only when neither intersection grows (comm -13 against the existing file
# is empty); net growth exits 1 without writing either file. A successful
# shrink refreshes the cache against the new baselines.
#
# Requires GOTOOLCHAIN pinned by the caller (pre-commit does this; standalone
# runs pin from go.mod below).

set -euo pipefail

# Byte-order collation for sort/comm (baseline files are C-locale sorted;
# locale-aware sort produces a different order and comm fails on it).
export LC_ALL=C

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

# Pin the toolchain deadcode's package loading uses (same rationale as the
# main pre-commit: GOTOOLCHAIN=auto never downgrades and breaks x/tools).
if [ -z "${GOTOOLCHAIN:-}" ] || [ "$GOTOOLCHAIN" = "auto" ]; then
    export GOTOOLCHAIN="$(sed -n 's/^toolchain[[:space:]]//p' "$PWD/go.mod" | head -1)"
fi
if [ -z "${GOTOOLCHAIN:-}" ]; then
    export GOTOOLCHAIN="$(sed -n 's/^go[[:space:]]//p' "$PWD/go.mod" | head -1)"
fi

REBASELINE=0
if [ "${1:-}" = "--rebaseline" ]; then
    REBASELINE=1
fi

FULL_TREE="${MEEPT_DEADCODE_FULL_TREE:-0}"

BASELINE="${MEEPT_DEADCODE_BASELINE:-$PWD/.githooks/deadcode-baseline.txt}"
BASELINE_NOTEST="${MEEPT_DEADCODE_BASELINE_NOTEST:-$PWD/.githooks/deadcode-baseline-notest.txt}"

# Production mains to analyze. Override with MEEPT_DEADCODE_MAINS for
# testing/CI. A function counts as unwired only if unreachable from EVERY
# one of these entry points.
MAINS_DEFAULT="./cmd/meept-daemon ./cmd/meept ./cmd/meept-lite ./cmd/meept-classifier-test ./tools/bridges-eval"
MAINS="${MEEPT_DEADCODE_MAINS:-$MAINS_DEFAULT}"

# --- Result cache plumbing (gates-speedup item 5) --------------------------
#
# CACHE_ROOT: <git-dir>/meept-cache/deadcode (outside the worktree: no
# .gitignore needed, never checked, safe to rm). Entries are keyed by a
# content digest of everything the analysis reads: the .go file contents of
# the analyzed tree (+ go.mod/go.sum), both baselines, the mains list, and
# the deadcode binary fingerprint.
GITDIR_ABS="$(git rev-parse --absolute-git-dir 2>/dev/null || true)"
CACHE_ENABLED=1
if [ "${MEEPT_DEADCODE_CACHE:-1}" = "0" ]; then
    CACHE_ENABLED=0
fi
if [ -z "$GITDIR_ABS" ] && [ -z "${MEEPT_DEADCODE_CACHE_DIR:-}" ]; then
    CACHE_ENABLED=0   # cannot resolve a cache root — full run, no cache
fi
CACHE_ROOT="${MEEPT_DEADCODE_CACHE_DIR:-${GITDIR_ABS:+$GITDIR_ABS/meept-cache/deadcode}}"

# Hash helper: shasum (macOS) else sha256sum (Linux CI).
if command -v shasum >/dev/null 2>&1; then
    hash_stream() { shasum -a 256 | cut -d' ' -f1; }
elif command -v sha256sum >/dev/null 2>&1; then
    hash_stream() { sha256sum | cut -d' ' -f1; }
else
    CACHE_ENABLED=0
    hash_stream() { cat >/dev/null; }
fi

# digest_inputs — the cache key. Contents-based by design ("invalidate on
# ANY .go content change" includes UNSTAGED edits, which an index-blob-id
# digest would miss). $PWD is the analyzed tree: the working tree by
# default, the prepared-commit snapshot when the dispatcher runs this gate
# gated (the chain cds there before exec'ing hooks; find then digests the
# exact bytes deadcode will read). bash-3.2/BSD-safe: no `sort -z` (BSD
# sort has no NUL mode) — hash first, sort the "hash  name" lines after.
digest_inputs() {
    {
        printf 'v3|MAINS=%s\n' "$MAINS"
        # Binary fingerprint: CONTENT hash via stdin (never the path — the
        # path embeds this run's temp dir when snapshot-gating, which made
        # every digest unique and the cache dead on arrival).
        cksum < "$DEADCODE_BIN" 2>/dev/null || true
        if command -v shasum >/dev/null 2>&1; then
            shasum -a 256 < "$BASELINE" 2>/dev/null || true
            shasum -a 256 < "$BASELINE_NOTEST" 2>/dev/null || true
            find . \( -path './.git' -o -path './.worktrees' -o -path './node_modules' -o -path './vendor' \) -prune \
                -o -type f -name '*.go' -print0 \
                | xargs -0 shasum -a 256 2>/dev/null \
                | LC_ALL=C sort || true
            shasum -a 256 go.mod 2>/dev/null || true
            shasum -a 256 go.sum 2>/dev/null || true
        else
            sha256sum < "$BASELINE" 2>/dev/null || true
            sha256sum < "$BASELINE_NOTEST" 2>/dev/null || true
            find . \( -path './.git' -o -path './.worktrees' -o -path './node_modules' -o -path './vendor' \) -prune \
                -o -type f -name '*.go' -print0 \
                | xargs -0 sha256sum 2>/dev/null \
                | LC_ALL=C sort || true
            sha256sum go.mod 2>/dev/null || true
            sha256sum go.sum 2>/dev/null || true
        fi
    } | hash_stream
}

# Allow-list growth is not a reachability question. A commit that only
# edits .githooks/deadcode-baseline*.txt used to hit the no-staged-.go
# return below and exit 0. Run the growth script first — before that
# return and before the missing-binary skip — so neither path can hide
# a larger allow-list. Relative path is intentional: when the dispatcher
# snapshot-gates this hook, cwd and GIT_WORK_TREE are the prepared-commit
# tree, and the script diffs those staged bytes against HEAD.
bash scripts/deadcode-baseline-growth-check.sh HEAD

# Locate the deadcode binary. A missing binary FAILS the gate: the whole
# point is deterministic enforcement, and a silent skip on a machine
# without the tool is how unwired code lands. The only escape hatch is an
# explicit opt-out (MEEPT_DEADCODE_ALLOW_SKIP=1), and never on CI.
# ALLOW_SKIP does not skip the growth check above.
# MEEPT_DEADCODE_BIN pins the binary directly (fixture seam; skips the PATH
# search — used by scripts/gates-speedup-selftest.sh with a stub that
# emulates deadcode's output format offline).
DEADCODE_BIN=""
if [ -n "${MEEPT_DEADCODE_BIN:-}" ]; then
    DEADCODE_BIN="$MEEPT_DEADCODE_BIN"
elif command -v deadcode &>/dev/null; then
    DEADCODE_BIN="$(command -v deadcode)"
elif [ -x "$HOME/go/bin/deadcode" ]; then
    DEADCODE_BIN="$HOME/go/bin/deadcode"
fi
if [ -z "$DEADCODE_BIN" ]; then
    if [ "${CI:-}" = "true" ]; then
        echo -e "${RED}✗ deadcode not installed — FAILING on CI (no skip allowed)${NC}"
        echo "   Install with: go install golang.org/x/tools/cmd/deadcode@v0.52.0"
        exit 1
    fi
    if [ "${MEEPT_DEADCODE_ALLOW_SKIP:-0}" = "1" ]; then
        echo -e "${YELLOW}⚠️  deadcode not installed — skip explicitly allowed via MEEPT_DEADCODE_ALLOW_SKIP=1${NC}"
        exit 0
    fi
    echo -e "${RED}✗ deadcode not installed — reachability gate is fail-closed${NC}"
    echo "   Install with: go install golang.org/x/tools/cmd/deadcode@v0.52.0"
    echo "   To skip deliberately (local only): MEEPT_DEADCODE_ALLOW_SKIP=1 git commit ..."
    exit 1
fi

# No staged Go files → skip the reachability analysis (unless CI/full-tree
# mode is enforcing the whole tree). The growth check above already ran.
# A failing git diff must not look like an empty staged set (that path
# exits 0). Do not swallow stderr or a non-zero status from git.
if [ "$FULL_TREE" != "1" ]; then
    if ! staged_names=$(git -c color.ui=false -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR); then
        echo -e "${RED}✗ git diff --cached failed — cannot tell whether Go files are staged${NC}" >&2
        exit 1
    fi
    # grep exits 1 when nothing matches. That is an empty Go set, not a
    # git failure — do not let it abort under pipefail.
    STAGED_GO_FILES=$(printf '%s\n' "$staged_names" | grep '\.go$') || STAGED_GO_FILES=""
    if [ -z "$STAGED_GO_FILES" ] && [ "$REBASELINE" -eq 0 ]; then
        exit 0
    fi
fi

# Normalize deadcode output to "path: unreachable func: Name" (no line:col —
# those move on every edit and would churn the baseline).
normalize() {
    sed -E 's/:[0-9]+:[0-9]+: unreachable func:/ unreachable func:/'
}

TMPDIR_CURRENT="$(mktemp -d -t meept-deadcode.XXXXXX)"
trap 'rm -rf "$TMPDIR_CURRENT"' EXIT

# analyze_mode <suffix> <extra deadcode flags...>
#
# Runs every binary, intersects the per-binary unreachable sets
# (comm-style incremental intersection — a function is only "currently
# unwired" if unreachable from ALL entry points), and leaves the sorted
# result in $TMPDIR_CURRENT/inter.<suffix>. A deadcode failure means the
# working tree does not typecheck/build — fail closed (pre-commit-build
# runs earlier and should have caught it, so reaching this failure is
# unexpected).
analyze_mode() {
    SUFFIX="$1"
    shift
    FIRST=1
    : > "$TMPDIR_CURRENT/inter.$SUFFIX"
    for MAIN in $MAINS; do
        TAG=$(echo "$MAIN" | tr '/.' '__')
        OUT="$TMPDIR_CURRENT/run$TAG.$SUFFIX"
        if ! "$DEADCODE_BIN" "$@" "$MAIN" > "$OUT" 2>&1; then
            echo -e "${RED}✗ deadcode failed on $MAIN (mode: $SUFFIX — build/typecheck problem?)${NC}"
            head -20 "$OUT"
            exit 1
        fi
        normalize < "$OUT" > "$OUT.norm"
        if [ "$FIRST" -eq 1 ]; then
            LC_ALL=C sort -u "$OUT.norm" > "$TMPDIR_CURRENT/acc"
            FIRST=0
        else
            # Intersection so far: entries present in BOTH the accumulator and
            # this binary's set (comm -12 needs LC_ALL=C-sorted inputs).
            LC_ALL=C sort -u -o "$TMPDIR_CURRENT/acc" "$TMPDIR_CURRENT/acc"
            LC_ALL=C sort -u -o "$OUT.norm" "$OUT.norm"
            comm -12 "$TMPDIR_CURRENT/acc" "$OUT.norm" > "$TMPDIR_CURRENT/acc.next"
            mv "$TMPDIR_CURRENT/acc.next" "$TMPDIR_CURRENT/acc"
        fi
    done
    LC_ALL=C sort -u -o "$TMPDIR_CURRENT/acc" "$TMPDIR_CURRENT/acc"
    cp "$TMPDIR_CURRENT/acc" "$TMPDIR_CURRENT/inter.$SUFFIX"
}

# Baselines must exist before hashing them — EXCEPT in rebaseline mode,
# which still runs the analysis when a file is missing so the growth check
# can refuse (a missing file is an empty existing set; a non-empty
# intersection is growth and is not written).
if [ "$REBASELINE" -eq 0 ]; then
    for BASE in "$BASELINE" "$BASELINE_NOTEST"; do
        if [ ! -f "$BASE" ]; then
            echo -e "${RED}✗ deadcode baseline missing: $BASE${NC}"
            echo "  Restore it from version control. Do not rebaseline."
            echo "  Do not edit the baseline files."
            exit 1
        fi
    done
fi

# --- Cache lookup ----------------------------------------------------------
# A HIT needs the two per-mode intersection outputs, which are the ONLY
# data the diff-vs-baseline step reads afterwards. Fail-closed: only a
# PASSING gate result is ever stored (cache_store at the end); a gate
# failure purges the entry, and cache-disabled/miss always does the full
# analysis.
CACHE_KEY=""
CACHE_HIT=0
if [ "$CACHE_ENABLED" = "1" ]; then
    mkdir -p "$CACHE_ROOT" 2>/dev/null || CACHE_ENABLED=0
fi
if [ "$CACHE_ENABLED" = "1" ]; then
    # A digest failure (missing hash tool, unreadable file mid-walk) must
    # NEVER fail the gate — degrade to an uncached full run.
    CACHE_KEY="$(digest_inputs 2>/dev/null || true)"
    if [ -z "$CACHE_KEY" ]; then
        CACHE_ENABLED=0
        echo "deadcode cache: digest unavailable — running full analysis (uncached)"
    fi
fi
if [ "$CACHE_ENABLED" = "1" ]; then
    if [ "$REBASELINE" -eq 0 ] \
        && [ -s "$CACHE_ROOT/$CACHE_KEY/digest" ] \
        && [ -f "$CACHE_ROOT/$CACHE_KEY/inter.test" ] \
        && [ -f "$CACHE_ROOT/$CACHE_KEY/inter.notest" ]; then
        cp "$CACHE_ROOT/$CACHE_KEY/inter.test" "$TMPDIR_CURRENT/inter.test"
        cp "$CACHE_ROOT/$CACHE_KEY/inter.notest" "$TMPDIR_CURRENT/inter.notest"
        CACHE_HIT=1
        echo "deadcode cache: HIT (digest ${CACHE_KEY:0:12}, 5-main analysis reused — nothing re-analyzed)"
    elif [ "$REBASELINE" -eq 0 ]; then
        echo "deadcode cache: MISS (digest ${CACHE_KEY:0:12}) — running full analysis"
    fi
fi
if [ "${MEEPT_DEADCODE_VERBOSE:-0}" = "1" ] && [ -n "$CACHE_KEY" ]; then
    echo "deadcode cache: verbose digest=$CACHE_KEY hit=$CACHE_HIT"
fi

if [ "$CACHE_HIT" -eq 0 ]; then
    analyze_mode test -test
    analyze_mode notest
fi

cache_store() {
    # Only called on the PASS path (and after --rebaseline). Writes the
    # digest as a sentinel file so a half-written entry never validates.
    # TOCTOU guard: re-digest after the analysis; if the tree moved while
    # deadcode ran, the result belongs to a DIFFERENT key than the one we
    # computed — drop it rather than risk a wrong future HIT.
    [ "$CACHE_ENABLED" = "1" ] && [ -n "$CACHE_KEY" ] || return 0
    if [ "${REBASELINE:-0}" != "1" ]; then
        post_key="$(digest_inputs)"
        if [ "$post_key" != "$CACHE_KEY" ]; then
            echo "deadcode cache: tree changed mid-analysis — result not cached (correctness over speed)"
            return 0
        fi
    fi
    mkdir -p "$CACHE_ROOT/$CACHE_KEY" 2>/dev/null || return 0
    cp "$TMPDIR_CURRENT/inter.test" "$CACHE_ROOT/$CACHE_KEY/inter.test.tmp" 2>/dev/null || return 0
    cp "$TMPDIR_CURRENT/inter.notest" "$CACHE_ROOT/$CACHE_KEY/inter.notest.tmp" 2>/dev/null || return 0
    mv "$CACHE_ROOT/$CACHE_KEY/inter.test.tmp" "$CACHE_ROOT/$CACHE_KEY/inter.test" 2>/dev/null || return 0
    mv "$CACHE_ROOT/$CACHE_KEY/inter.notest.tmp" "$CACHE_ROOT/$CACHE_KEY/inter.notest" 2>/dev/null || return 0
    printf '%s\n' "$CACHE_KEY" > "$CACHE_ROOT/$CACHE_KEY/digest" 2>/dev/null || return 0
    return 0
}

cache_purge() {
    [ "$CACHE_ENABLED" = "1" ] && [ -n "$CACHE_KEY" ] || return 0
    rm -rf "$CACHE_ROOT/$CACHE_KEY" 2>/dev/null || true
    return 0
}

# rebaseline_growth_lines <existing> <new>
# Lines in <new> absent from <existing> (comm -13, LC_ALL=C). A missing
# existing file is an empty set, so every new line is growth. Inputs are
# sorted here; comm's contract requires LC_ALL=C order.
rebaseline_growth_lines() {
    _rg_existing="$1"
    _rg_new="$2"
    if [ -f "$_rg_existing" ]; then
        LC_ALL=C sort -u "$_rg_existing" > "$TMPDIR_CURRENT/growth.old"
    else
        : > "$TMPDIR_CURRENT/growth.old"
    fi
    LC_ALL=C sort -u "$_rg_new" > "$TMPDIR_CURRENT/growth.new"
    LC_ALL=C comm -13 "$TMPDIR_CURRENT/growth.old" "$TMPDIR_CURRENT/growth.new"
}

# Append a capped listing of growth lines. Sets _rg_any=1 when non-empty.
_rebaseline_note_growth() {
    _rg_label="$1"
    _rg_lines="$2"
    if [ -z "$_rg_lines" ]; then
        return 0
    fi
    _rg_any=1
    printf '%s\n' "$_rg_lines" > "$TMPDIR_CURRENT/growth.lines"
    {
        echo "  $_rg_label:"
        head -40 "$TMPDIR_CURRENT/growth.lines" | sed 's/^/    /'
        _rg_total=$(grep -c . "$TMPDIR_CURRENT/growth.lines" || true)
        if [ "$_rg_total" -gt 40 ]; then
            echo "    ... and $((_rg_total - 40)) more"
        fi
    } >> "$_rg_report"
}

# refuse_rebaseline_growth — check BOTH baselines before writing EITHER.
# Net growth (any line in the new intersection absent from the existing
# file) prints those lines, capped at 40 per baseline, and exits 1.
# Shrink and equal sets return so the caller can write both files.
refuse_rebaseline_growth() {
    _rg_report="$TMPDIR_CURRENT/growth.report"
    : > "$_rg_report"
    _rg_any=0
    _rebaseline_note_growth "-test" "$(rebaseline_growth_lines "$BASELINE" "$TMPDIR_CURRENT/inter.test")"
    _rebaseline_note_growth "no-test" "$(rebaseline_growth_lines "$BASELINE_NOTEST" "$TMPDIR_CURRENT/inter.notest")"
    if [ "$_rg_any" -eq 1 ]; then
        echo -e "${RED}✗ deadcode --rebaseline refused: net growth${NC}"
        echo "  New lines are absent from the existing baseline. Neither file was written."
        echo "  A rebaseline may only shrink or stay equal."
        cat "$_rg_report"
        exit 1
    fi
}

if [ "$REBASELINE" -eq 1 ]; then
    refuse_rebaseline_growth
    cp "$TMPDIR_CURRENT/inter.test" "$BASELINE"
    cp "$TMPDIR_CURRENT/inter.notest" "$BASELINE_NOTEST"
    # Refresh the cache against the NEW baselines (the digest embeds their
    # hashes, so the old entry is stale the moment they change).
    if [ "$CACHE_ENABLED" = "1" ]; then
        CACHE_KEY="$(digest_inputs)"
        cache_store
    fi
    echo -e "${GREEN}✓ deadcode baselines regenerated:${NC}"
    echo "  $BASELINE ($(wc -l < "$BASELINE" | tr -d ' ') unreachable funcs, -test mode)"
    echo "  $BASELINE_NOTEST ($(wc -l < "$BASELINE_NOTEST" | tr -d ' ') unreachable funcs, no-test mode)"
    echo "  Stage them: git add $BASELINE $BASELINE_NOTEST"
    exit 0
fi

# report_new <label> <baseline> <current>
# Records the failure in GATE_FAILED (the CALLER exits 1 after both
# passes report); it does not exit non-zero itself.
GATE_FAILED=0
report_new() {
    LABEL="$1"
    BASE="$2"
    CUR="$3"
    # New = in the current set but not in the baseline (comm -13). No
    # `|| true`: comm fails (exit 1) on unsorted input, and swallowing
    # that would truncate the output into a false clean pass. Both
    # baselines are written LC_ALL=C-sorted; a mis-sorted baseline now
    # fails the gate via set -e instead of silently passing.
    NEW_FUNCS=$(comm -13 "$BASE" "$CUR")
    if [ -n "$NEW_FUNCS" ]; then
        NEW_COUNT=$(printf '%s\n' "$NEW_FUNCS" | grep -c . || true)
        echo -e "${RED}✗ deadcode gate ($LABEL): $NEW_COUNT newly unwired function(s) — commit blocked${NC}"
        echo ""
        printf '%s\n' "$NEW_FUNCS" | head -30 | sed 's/^/  /'
        TOTAL_SHOW=$(printf '%s\n' "$NEW_FUNCS" | grep -c .)
        if [ "$TOTAL_SHOW" -gt 30 ]; then
            echo "  ... and $((TOTAL_SHOW - 30)) more"
        fi
        echo ""
        GATE_FAILED=1
    else
        echo -e "${GREEN}✓ deadcode gate ($LABEL): no newly unwired code ($(wc -l < "$CUR" | tr -d ' ') unreachable funcs, at baseline)${NC}"
    fi
}

report_new "-test" "$BASELINE" "$TMPDIR_CURRENT/inter.test"
report_new "no-test" "$BASELINE_NOTEST" "$TMPDIR_CURRENT/inter.notest"

if [ "$GATE_FAILED" -eq 1 ]; then
    # Fail-closed cache rule: never leave an entry that could replay this
    # tree as a prior pass, even if it was stored for an identical earlier
    # digest (it cannot be — same inputs, same verdict — belt-and-braces).
    cache_purge
    echo "  Fix: wire the function into a production call path, or delete it."
    echo "  A function whose only caller is its own test is not wired."
    echo "  Do not rebaseline. Do not edit the baseline files."
    echo "  Do not use git commit --no-verify."
    exit 1
fi

# Gate passed: store the analysis result for the identical next digest.
cache_store

exit 0
