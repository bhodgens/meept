#!/usr/bin/env bash
#
# pre-commit-e2e — enforce the e2e testing policy on staged Go changes.
#
# Two failure modes (fail-closed):
#
#   1. New-package census (hard gate, fail-closed): every NEW package
#      directory in the staged diff — a directory with no path_map entry
#      under the manifest's bidirectional-prefix normalization — FAILS the
#      commit unless either (a) the commit also stages a path_map key that
#      covers the dir, or (b) e2e/manifest.json carries an "exempt" entry
#      mapping the dir to a non-empty reason string. Exemptions are printed
#      in the report so the exception list stays visible as residual risk.
#      Test-only additions (a dir whose staged Go files are all *_test.go)
#      never open a new package dir; neither do exempt paths (_test.go,
#      docs, generated, ui/, tools/, magefiles/, scripts/, config/, theme/).
#      The population is staged ADDITIONS only, so no historical baseline
#      is needed — existing unmapped dirs pass until someone re-adds files
#      under them.
#
#      Non-vacuity floors (each exits 1 loudly): a manifest that fails to
#      parse, zero path_map entries, or a census that parsed zero staged
#      dirs on a commit that adds non-test internal/|pkg/|cmd/ Go files.
#      A checker that matches nothing is a false green, not a pass.
#
#   2. Affected-suite sweep — MOVED OUT of pre-commit (gates-speedup item
#      1). Running the transitively-mapped suites here cost 15-25 minutes on
#      a green commit touching internal/queue|agent|task. The sweep still
#      runs at TWO enforcement sites:
#        - .githooks/pre-push-e2e (FULL fan-out scope, push boundary)
#        - CI: ci.yml job e2e-fast (`make e2e-fast`, required member of
#          the ci-success aggregate gate)
#      Only the CHEAP census half (mode 1 above) stays in pre-commit: it
#      blocks forgetting the manifest without paying for suite runtime.
#      Developers who want the sweep pre-push:
#        scripts/e2e-affected.sh --from-diff              (full fan-out)
#        MEEPT_E2E_SCOPE=direct scripts/e2e-affected.sh   (package-dir-only,
#                                                          cheap; see README)
#
# This is the repo's NO-NEW-UNIT-TESTS policy enforcement point: all new
# feature tests go in the e2e tier (see docs/workflows/e2e-testing.md).
#
# Escape hatch (emergencies only — prints a loud warning, stays in the
# transcript):
#   MEEPT_SKIP_E2E=1 git commit ...
#
# Test seams (mirrors MEEPT_DEADCODE_BASELINE in pre-commit-deadcode):
#   MEEPT_E2E_CENSUS_STAGED_FILE=/path/to/file   census fixture mode: read
#     the staged ACMR list from FILE (one path per line, exactly what
#     `git diff --cached --name-only --diff-filter=ACMR` prints) instead of
#     the git index, evaluate the census against MEEPT_E2E_MANIFEST_FILE
#     (or REPO_ROOT/e2e/manifest.json), and exit before the affected-suite
#     gate — a synthetic list must never drive `go test`. Lets e2e-census
#     fixtures prove the gate without touching a shared worktree's index.
#   MEEPT_E2E_MANIFEST_FILE=/path/to/file   fixture-only manifest override;
#     requires MEEPT_E2E_CENSUS_STAGED_FILE (real commits always evaluate
#     the STAGED manifest copy so same-commit keys count).
#   MEEPT_E2E_PRECOMMIT_SWEEP=1   opt back IN to the affected-suite sweep
#     at commit time (the pre-gates-speedup behavior) — for a developer who
#     wants it locally. Combine with MEEPT_E2E_SCOPE=direct for the cheap
#     package-dir-only version. The default is OFF; pre-push-e2e + CI remain
#     the enforcement sites.
#
# Exempt paths (never trigger either mode): _test.go files, docs/,
# e2e/ harness+manifest itself, generated dirs, ui/, tools/, magefiles/.

set -u -o pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

AFFECTED_SCRIPT="scripts/e2e-affected.sh"

# Staged paths (index, not worktree) — added/copied/modified/renamed.
# In seam mode (MEEPT_E2E_CENSUS_STAGED_FILE, see header) the list comes
# from FILE and the git index is never read.
if [ -n "${MEEPT_E2E_CENSUS_STAGED_FILE:-}" ]; then
    if [ ! -f "$MEEPT_E2E_CENSUS_STAGED_FILE" ]; then
        echo "pre-commit-e2e: MEEPT_E2E_CENSUS_STAGED_FILE=$MEEPT_E2E_CENSUS_STAGED_FILE does not exist — fail-closed." >&2
        exit 1
    fi
    STAGED="$(cat "$MEEPT_E2E_CENSUS_STAGED_FILE")"
    echo "pre-commit-e2e: census using staged-file seam $MEEPT_E2E_CENSUS_STAGED_FILE (no git index reads)."
else
    STAGED="$(git diff --cached --name-only --diff-filter=ACMR || true)"
fi
if [ -z "$STAGED" ] && [ -z "${MEEPT_E2E_CENSUS_STAGED_FILE:-}" ]; then
    echo "pre-commit-e2e: no staged changes — nothing to check."
    exit 0
fi

if [ "${MEEPT_SKIP_E2E:-0}" = "1" ]; then
    echo ""
    echo "============================================================"
    echo "  !!! E2E ENFORCEMENT SKIPPED — MEEPT_SKIP_E2E=1 !!!"
    echo "  The affected-suite gate and new-feature coverage rule"
    echo "  were NOT run for this commit. This is an escape hatch:"
    echo "  use it for emergencies only and follow up with a commit"
    echo "  that runs the affected suites."
    echo "============================================================"
    echo ""
    exit 0
fi

TMP="$(mktemp "${TMPDIR:-/tmp}/pre-commit-e2e.XXXXXX")"
trap 'rm -f "$TMP"' EXIT
printf '%s\n' "$STAGED" > "$TMP"

# --- Mode 1: new-package census (hard gate) --------------------------------
#
# Population: staged rows that can OPEN a new package dir — ADDITIONS (A),
# COPIES (C), and RENAMES (R; the NEW path) — as
# `git diff --cached --name-status --diff-filter=ACMR` rows minus plain
# modifies (M already-existed-at-baseline dirs are not new), for non-test
# .go files under internal/ | pkg/ | cmd/, minus is_exempt-style paths
# (_test.go, */generated/*). Package dirs = dirname of each. A dir passes
# iff the manifest's OWN normalization predicate (trailing-slash
# normalization, bidirectional slash-boundary prefix match — identical
# semantics to the old per-file check, now run once against all dirs) says
# it is covered by a path_map key, OR an "exempt" key (dir -> non-empty
# reason string) covers it under the same predicate. Everything else blocks.
#
# The census evaluates the INDEX copy of e2e/manifest.json (git show
# :e2e/manifest.json), so a commit that adds both the package dir and the
# path_map key covering it passes atomically; with the
# MEEPT_E2E_CENSUS_STAGED_FILE seam it reads MEEPT_E2E_MANIFEST_FILE or the
# worktree manifest instead.
#
# There is deliberately NO blanket "some suite file is staged" escape any
# more: that let any commit pass by staging an unrelated file under
# e2e/suites/ (the hole the prior audit flagged). Coverage is path_map or
# annotated exemption, nothing else.

MANIFEST_TMP=""
CENSUS_TMP=""
trap 'rm -f "$TMP" "${MANIFEST_TMP:-}" "${CENSUS_TMP:-}"' EXIT

if [ -n "${MEEPT_E2E_CENSUS_STAGED_FILE:-}" ]; then
    # Fixture seam: the staged-file IS the additions list (one path per
    # line, as `git diff --cached --name-only --diff-filter=ACMR` prints).
    CENSUS_SRC="$MEEPT_E2E_CENSUS_STAGED_FILE"
    if [ -n "${MEEPT_E2E_MANIFEST_FILE:-}" ]; then
        if [ ! -f "$MEEPT_E2E_MANIFEST_FILE" ]; then
            echo "pre-commit-e2e: MEEPT_E2E_MANIFEST_FILE=$MEEPT_E2E_MANIFEST_FILE does not exist — fail-closed." >&2
            exit 1
        fi
        MANIFEST_PATH="$MEEPT_E2E_MANIFEST_FILE"
    else
        MANIFEST_PATH="$REPO_ROOT/e2e/manifest.json"
    fi
else
    if [ -n "${MEEPT_E2E_MANIFEST_FILE:-}" ]; then
        echo "pre-commit-e2e: MEEPT_E2E_MANIFEST_FILE is fixture-only — it requires MEEPT_E2E_CENSUS_STAGED_FILE (real commits must evaluate the staged manifest). Fail-closed." >&2
        exit 1
    fi
    CENSUS_TMP="$(mktemp "${TMPDIR:-/tmp}/pre-commit-e2e-census.XXXXXX")"
    # A/C/R, not just A: git rename detection (diff.renames=true, on by
    # default) emits R rows and ZERO A rows for renames, so a file renamed
    # into a brand-new unmapped dir would otherwise produce an empty
    # census and a false green. --name-status lets us keep exactly the
    # rows that OPEN a directory — A (add), C (copy), R (rename; $NF is
    # the NEW path) — while plain M (modify) rows stay excluded: a
    # modified file already existed at baseline, so its dir is not new
    # (case modified_only_not_censused in e2e-census-selftest.sh pins
    # that). pipefail makes a git failure fail the pipeline.
    if ! git diff --cached --name-status --diff-filter=ACMR \
            | awk -F'\t' '$1 != "M" { print $NF }' > "$CENSUS_TMP"; then
        echo "pre-commit-e2e: cannot read staged additions from the index (git diff failed) — fail-closed." >&2
        exit 1
    fi
    CENSUS_SRC="$CENSUS_TMP"
    # Read the manifest from the INDEX so same-commit path_map keys count.
    MANIFEST_TMP="$(mktemp "${TMPDIR:-/tmp}/pre-commit-e2e-manifest.XXXXXX")"
    if ! git show :e2e/manifest.json > "$MANIFEST_TMP" 2>/dev/null; then
        cp e2e/manifest.json "$MANIFEST_TMP" 2>/dev/null || true
    fi
    MANIFEST_PATH="$MANIFEST_TMP"
fi

# Independent (awk) count of census-list non-test feature Go files. The
# Python side re-derives its own filter; the two parsers must AGREE that a
# "clearly adds Go files" census is not parsed into zero dirs — a
# regression in either filter then trips the vacuity floor below instead
# of silently green-lighting the census.
shell_go_adds="$(awk '/\.go$/ && !/_test\.go$/ && !/\/generated\// && ($0 ~ /^(internal|pkg|cmd)\//)' "$CENSUS_SRC" | wc -l | tr -d ' "')"

python3 - "$MANIFEST_PATH" "$CENSUS_SRC" "$shell_go_adds" <<'PYEOF'
import json, os, sys

manifest_path, additions_path = sys.argv[1], sys.argv[2]
shell_go_adds = int(sys.argv[3]) if len(sys.argv) > 3 else 0

def vacuous(msg):
    print("")
    print("❌ pre-commit-e2e: new-package census is VACUOUS — refusing to pass")
    print("   A gate that can match nothing is a false green, not a pass.")
    print("   reason: %s" % msg)
    print("")
    sys.exit(2)

try:
    with open(manifest_path) as fh:
        manifest = json.load(fh)
except Exception as exc:
    vacuous("manifest %s did not parse: %s" % (manifest_path, exc))

path_map = manifest.get("path_map")
exempt = manifest.get("exempt", {})
if not isinstance(path_map, dict) or not path_map:
    vacuous("e2e/manifest.json has zero path_map entries")
if not isinstance(exempt, dict):
    vacuous("e2e/manifest.json 'exempt' is not an object (dir -> reason string)")

# Same filter the old per-file loop applied: non-test .go under the
# feature trees; generated paths are exempt (mirrors is_exempt).
added_go = []
with open(additions_path) as fh:
    for line in fh:
        f = line.strip()
        if not f or not f.endswith(".go") or f.endswith("_test.go"):
            continue
        if "/generated/" in f:
            continue
        if f.startswith("internal/") or f.startswith("pkg/") or f.startswith("cmd/"):
            added_go.append(f)

dirs = sorted(set(os.path.dirname(f) or "." for f in added_go))
# Non-vacuity floor (cross-parser): an independent awk pass counted
# shell_go_adds non-test feature Go files on the same list; if the Python
# census parsed any fewer to zero dirs, the checker matched nothing on a
# commit that clearly adds Go code — that is a false green, not a pass.
if shell_go_adds > 0 and not dirs:
    vacuous("census parsed 0 package dirs but awk sees %d added feature Go file(s)" % shell_go_adds)
if shell_go_adds > 0 and added_go and len(added_go) != shell_go_adds:
    vacuous("parser disagreement: awk=%d python=%d non-test feature Go files" % (shell_go_adds, len(added_go)))

# The repo's own normalization predicate (pre-commit-e2e, since 6b97665c /
# a7290da9): both sides trailing-slash-stripped; match iff dir equals key,
# key prefixes dir at a slash boundary, or dir prefixes key at a slash
# boundary. Reproduces the old per-dir check EXACTLY — a naive prefix grep
# would false-cover sibling dirs like internal/newpkg under key internal/new/.
def match_key(d, keys):
    d = d.rstrip("/")
    for k in keys:
        k0 = k.rstrip("/")
        if not k0:
            continue
        if d == k0 or k0.startswith(d + "/") or d.startswith(k0 + "/"):
            return k
    return None

blocked, mapped, exempted = [], [], []
for d in dirs:
    if match_key(d, path_map) is not None:
        mapped.append(d)
        continue
    ek = match_key(d, exempt)
    if ek is not None:
        reason = exempt.get(ek)
        if isinstance(reason, str) and reason.strip():
            exempted.append((d, reason.strip()))
            continue
        # An exemption without a reason string is no exemption at all —
        # the annotation is the whole point of the residual-risk list.
    blocked.append(d)

if blocked:
    print("")
    print("❌ pre-commit-e2e: NEW package directory staged without e2e coverage")
    print("")
    print("These package directories have no path_map entry in e2e/manifest.json")
    print("(under its bidirectional prefix normalization) and no 'exempt'")
    print("annotation:")
    for d in blocked:
        files = [f for f in added_go if (os.path.dirname(f) or ".") == d]
        print("  - %s  (%d new file(s), e.g. %s)" % (d, len(files), files[0]))
    print("")
    print("Repo policy (docs/workflows/e2e-testing.md): new feature tests go")
    print("in the hermetic e2e tier — NOT as new unit-test files.")
    print("")
    print("To fix (pick one):")
    print("  1. Create an e2e suite dir e2e/suites/<your-suite>/ with tests")
    print("     (build tag 'e2e'; see e2e/suites/smoke/ for the pattern),")
    print("     add a path_map entry + a suites[] row in e2e/manifest.json,")
    print("     and STAGE the manifest — the census reads the staged copy.")
    print("  2. Emergency-only exemption: add")
    print('       "exempt": {"<dir>": "<mandatory reason string>"}')
    print("     to e2e/manifest.json. Every hook run then prints it as")
    print("     residual risk; follow up with a real suite.")
    print("")
    sys.exit(1)

if exempted:
    print("")
    print("⚠️  pre-commit-e2e: new-package census — ANNOTATED EXEMPTIONS in use")
    print("   (residual risk; tracked in e2e/manifest.json 'exempt'):")
    for d, reason in exempted:
        print("  - %s — %s" % (d, reason))
    print("")
elif dirs:
    print("pre-commit-e2e: census: %d new package dir(s), all mapped in e2e/manifest.json." % len(dirs))
PYEOF
census_rc=$?
if [ "$census_rc" != "0" ]; then
    exit 1
fi

# Census-seam mode is fixture-only: never drive `go test` from a synthetic
# staged list (that would run suites against unrelated worktree state).
if [ -n "${MEEPT_E2E_CENSUS_STAGED_FILE:-}" ]; then
    echo "pre-commit-e2e: OK (census-seam mode — affected-suite gate not run)."
    exit 0
fi

# --- Mode 2: affected-suite sweep — OPT-IN only (gates-speedup item 1) ----
#
# The sweep left pre-commit: on a green commit touching internal/queue|
# agent|task it cost 15-25 minutes (serial transitively-mapped suites plus a
# serial flake retry). Enforcement moved to pre-push-e2e (FULL scope) and CI
# (ci.yml e2e-fast, a ci-success member). A developer who still wants the
# commit-boundary sweep sets MEEPT_E2E_PRECOMMIT_SWEEP=1; MEEPT_E2E_SCOPE=
# direct makes it package-dir-only and much cheaper.

if [ "${MEEPT_E2E_PRECOMMIT_SWEEP:-0}" != "1" ]; then
    echo "pre-commit-e2e: census OK. Suite sweep not run at commit time (moved to pre-push-e2e + CI; opt in with MEEPT_E2E_PRECOMMIT_SWEEP=1)."
    echo "pre-commit-e2e: OK"
    exit 0
fi

# Mode 2 only applies to Go files under internal/, pkg/, cmd/.
feature_go=0
while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in
        *.go) ;;
        *) continue ;;
    esac
    case "$f" in
        internal/*|pkg/*|cmd/*) feature_go=1 ;;
    esac
done < "$TMP"

if [ "$feature_go" = "1" ]; then
    echo "pre-commit-e2e: MEEPT_E2E_PRECOMMIT_SWEEP=1 — running affected hermetic e2e suites on staged paths (scope: ${MEEPT_E2E_SCOPE:-full})..."
    # Hand the staged paths straight to the affected script (it reads stdin
    # when no args are given). Any failing suite fails the commit.
    if ! "$REPO_ROOT/$AFFECTED_SCRIPT" < "$TMP"; then
        echo ""
        echo "❌ pre-commit-e2e: affected e2e suite(s) FAILED — commit blocked."
        echo "   Fix the failing suite, or stage fixes alongside this change."
        echo "   Emergency-only bypass: MEEPT_SKIP_E2E=1 git commit"
        echo ""
        exit 1
    fi
else
    echo "pre-commit-e2e: no feature Go files staged — suite sweep not applicable."
fi

echo "pre-commit-e2e: OK"
exit 0
