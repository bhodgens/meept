#!/bin/bash
# Pre-commit hook that checks for common error handling anti-patterns.
#
# Scope: ADDED lines only. Scans `git diff --cached` for newly-introduced
# anti-patterns; pre-existing issues in untouched code are not blocked.
# To fix the whole tree, run the hook manually on a no-op staged change
# or sweep with: grep -rn "_ = " internal/ cmd/ | grep -v _test.go
#
# This hook detects (newly added):
# - Ignored errors (_ = someFunc())
# - panic(err) in non-test code
# - fmt.Errorf without %w for wrapping (informational, not blocking)
# - Unwired placeholder seam calls: Set*Provider/Sink/Source/Relay/Adapter/
#   Handler/Emitter/Publisher(...) passing a bare nil literal in non-test additions
#   (the "wired with a nil provider" placeholder agents emit instead of
#   real wiring; suppress an intentional call with //nolint:nilseam and a
#   reason, the repo-wide annotation convention; the marker is honored on
#   the same line or the immediately preceding line, and multi-line
#   calls are joined into logical lines before matching)
#
# Installation: Included in .githooks/pre-commit

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Checking error handling patterns (added lines only)${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Get staged Go files (excluding test files)
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null | grep '\.go$' | grep -v '_test\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
  echo -e "${GREEN}✅ No Go source files staged${NC}"
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

ISSUE_COUNT=0
BLOCK_COUNT=0

echo "Checking files:"
echo "$STAGED_GO_FILES" | sed 's/^/  /'
echo ""

for file in $STAGED_GO_FILES; do
  if [ ! -f "$file" ]; then
    continue
  fi

  # Skip generated code
  if grep -q "^// Code generated" "$file" 2>/dev/null; then
    continue
  fi

  # Extract added lines from the staged diff for THIS file.
  # -U0 disables context, '^+' matches added lines, strip the leading '+'.
  # We include the line number from the patched file via grep -n against the
  # post-image content (using `git diff --cached --no-color -U0` and walking
  # the @@ hunk headers would be cleaner, but this approximation is good
  # enough: we grep added-line content from the diff and then locate it in
  # the working-tree file for a line number).
  ADDED_LINES=$(git diff --cached -U0 -- "$file" 2>/dev/null | grep -E '^\+' | sed 's/^+//')

  if [ -z "$ADDED_LINES" ]; then
    continue
  fi

  FILE_ISSUES=""
  BLOCKING_ISSUES=""

  # Check 1: Ignored errors with _ =
  # Match exact added lines containing "_ = " outside comments.
  # Comma-ok type assertions (`v, _ := x.(T)` / `v, _ = x.(T)`) are NOT
  # ignored errors — they are the mandated form for map[string]any payload
  # access (see AGENTS.md "Error handling") — so lines whose assignment
  # extracts from a type assertion `\.(...)` are exempt.
  while IFS= read -r pattern; do
    [ -z "$pattern" ] && continue
    # Skip known safe patterns
    echo "$pattern" | grep -qE "WithoutCancel|WithoutTimeout|WithoutDeadline" && continue
    # Skip comment lines
    echo "$pattern" | grep -qE "^\s*//" && continue
    # Skip lines where every "_ = " occurrence sits inside a quoted string
    # literal (e.g. `const msg = "use _ = doThing() never"`). Strip all
    # double-quoted spans first; if no "_ = " remains outside quotes, the
    # match was string content, not code.
    if ! echo "$pattern" | sed 's/"[^"]*"//g' | grep -qF "_ = "; then
      continue
    fi
    # Skip comma-ok type assertions: ", _ :=" / ", _ =" paired with ".("
    echo "$pattern" | grep -qE ',\s*_\s*(:=|=)[^=]*\.\(' && continue
    # Locate in file for line number
    LINE_NUMS=$(grep -nF "$pattern" "$file" 2>/dev/null | cut -d: -f1)
    for ln in $LINE_NUMS; do
      BLOCKING_ISSUES="${BLOCKING_ISSUES}  ❌ Ignored error (_ =):\n    $file:$ln: $pattern\n"
      BLOCK_COUNT=$((BLOCK_COUNT + 1))
    done
  done <<< "$(echo "$ADDED_LINES" | grep -F "_ = " || true)"

  # Check 2: panic(err) usage
  while IFS= read -r pattern; do
    [ -z "$pattern" ] && continue
    LINE_NUMS=$(grep -nF "$pattern" "$file" 2>/dev/null | cut -d: -f1)
    for ln in $LINE_NUMS; do
      FILE_ISSUES="${FILE_ISSUES}  ⚠️  panic(err) found:\n    $file:$ln: $pattern\n"
      BLOCKING_ISSUES="${BLOCKING_ISSUES}  ❌ panic(err):\n    $file:$ln: $pattern\n"
      BLOCK_COUNT=$((BLOCK_COUNT + 1))
    done
  done <<< "$(echo "$ADDED_LINES" | grep -F "panic(err)" | grep -vE '^\s*//' || true)"

  # Check 3: fmt.Errorf without %w (informational only — not blocking)
  # Only flag when the call wraps a variable (heuristic: contains ", <identifier>)"
  # suggesting an err was passed but not wrapped. Pure literal messages are fine.
  while IFS= read -r pattern; do
    [ -z "$pattern" ] && continue
    # Skip if it already uses %w
    echo "$pattern" | grep -q '%w' && continue
    # Skip pure-literal errors (no err variable being passed)
    # Heuristic: if the format call has 2+ args beyond the format string,
    # one of them might be an err. This is loose but reduces noise.
    LINE_NUMS=$(grep -nF "$pattern" "$file" 2>/dev/null | cut -d: -f1)
    for ln in $LINE_NUMS; do
      FILE_ISSUES="${FILE_ISSUES}  ℹ️  fmt.Errorf without %w (consider wrapping):\n    $file:$ln: $pattern\n"
    done
  done <<< "$(echo "$ADDED_LINES" | grep -F 'fmt.Errorf(' | grep -vE '^\s*//' || true)"

  # Check 4: Unwired placeholder seam calls — Set*Provider/Sink/Source/
  # Relay/Adapter/Handler/Emitter/Publisher(...) with a bare nil literal
  # argument.
  # Agents emit these instead of constructing the real adapter: the seam
  # compiles, stays inert, the feature is silently unimplemented. Scope:
  # newly-added lines in NON-TEST Go only (test files are already excluded
  # via STAGED_GO_FILES; tests legitimately exercise nil guards).
  # Exempt with //nolint:nilseam + reason (repo-wide annotation convention,
  # see pre-commit-channel-nilafterclose / pre-commit-predictable-ids) or
  # the equivalent '// nilseam: allow' marker — honored on the call line
  # OR the immediately preceding line.
  # Multi-line calls are handled first: ADDED lines are joined into
  # LOGICAL lines — a line is appended to the previous one while paren
  # depth is positive (counted naively over ( and ); string/comment
  # contents are NOT excluded — kept simple on purpose, matching this
  # file's grep-grade heuristics). Without the join, the common diff
  # shape `mgr.SetHandler(\n\t nil,\n)` has no single line holding both
  # the setter and nil, and the gate exits 0 on exactly what it blocks.
  # awk emits "<SUPPRESS><TAB><logical>" per logical line, where SUPPRESS
  # is 1 when the call line or the line immediately BEFORE it (the same
  # logical line or the previous emitted one) carries
  # //nolint:nilseam / 'nilseam: allow'. Simplified single-file shape:
  # one awk pass, no per-pattern re-scanning of ADDED_LINES.
  LOGICAL_LINES=$(awk '
    {
      line = $0
      suppressed = (line ~ /nolint:nilseam|nilseam: allow/) ? 1 : 0
      if (pending != "" && depth > 0) {
        pending = pending " " line
        if (suppressed) pend_sup = 1
      } else {
        if (pending != "") printf "%d\t%s\n", pend_sup, pending
        pending = line
        # A call is suppressed when its own line(s) OR the ADDED line
        # immediately before it carries the marker (preceding-line nolint).
        pend_sup = (suppressed || last_sup) ? 1 : 0
      }
      last_sup = suppressed
      n = gsub(/\(/, "(", line); m = gsub(/\)/, ")", line)
      depth += n - m
      if (depth < 0) depth = 0
      if (depth <= 0) {
        # Logical line complete: flush immediately so the next line can
        # act as a fresh preceding-line nolint candidate.
        if (pending != "") { printf "%d\t%s\n", pend_sup, pending; pending = ""; pend_sup = 0 }
      }
    }
    END { if (pending != "") printf "%d\t%s\n", pend_sup, pending }
  ' <<< "$ADDED_LINES")
  while IFS= read -r row; do
    [ -z "$row" ] && continue
    suppressed="${row%%$'\t'*}"
    pattern="${row#*$'\t'}"
    [ "$suppressed" = "1" ] && continue
    # Skip comment-only logical lines
    echo "$pattern" | grep -qE '^\s*//' && continue
    # Strip string literals so "nil" inside text doesn't count
    code=$(echo "$pattern" | sed 's/"[^"]*"//g')
    # Extract the argument list of the seam-setter call (flat, no nested
    # parens — the placeholder shape is always SetX(nil) / SetX(a, nil);
    # the logical-line join above flattens multi-line calls into one).
    args=$(echo "$code" | sed -nE 's/.*Set[A-Za-z0-9_]*(Provider|Sink|Source|Relay|Adapter|Handler|Emitter|Publisher)\(([^()]*)\).*/\2/p')
    [ -z "$args" ] && continue
    # Require nil as a WHOLE argument (not a substring of an identifier)
    echo "$args" | grep -qE '(^|,)[[:space:]]*nil[[:space:]]*($|,)' || continue
    LINE_NUMS=$(grep -nF "$(echo "$pattern" | awk '{print $1}')" "$file" 2>/dev/null | cut -d: -f1)
    LN_HINT=""
    # Best-effort line number: locate the call's first token span in the
    # file; fall back to a bare file reference when the joined shape does
    # not exist verbatim in the file.
    FIRST_TOKEN=$(echo "$pattern" | grep -oE 'Set[A-Za-z0-9_]*(Provider|Sink|Source|Relay|Adapter|Handler|Emitter|Publisher)\(' | head -1)
    if [ -n "$FIRST_TOKEN" ]; then
      LN_HINT=$(grep -nF "$FIRST_TOKEN" "$file" 2>/dev/null | cut -d: -f1 | head -1)
    fi
    SETTER_NAME=$(echo "$pattern" | sed -nE 's/.*(Set[A-Za-z0-9_]*(Provider|Sink|Source|Relay|Adapter|Handler|Emitter|Publisher))\(.*/\1/p')
    BLOCKING_ISSUES="${BLOCKING_ISSUES}  ❌ Unwired placeholder seam call (nil passed to ${SETTER_NAME:-unknown setter}):\n    $file:${LN_HINT:-?}: $pattern\n"
    BLOCK_COUNT=$((BLOCK_COUNT + 1))
  done <<< "$LOGICAL_LINES"

  if [ -n "$FILE_ISSUES" ]; then
    echo -e "${YELLOW}⚠️  $file:${NC}"
    echo -e "$FILE_ISSUES"
    ISSUE_COUNT=$((ISSUE_COUNT + 1))
  fi
done

if [ -n "$BLOCKING_ISSUES" ]; then
  echo ""
  echo -e "${RED}━━━ BLOCKING issues (commit will fail) ━━━${NC}"
  echo -e "$BLOCKING_ISSUES"
fi

# Blocking findings must fail the gate on their OWN — not only when an
# unrelated informational (fmt.Errorf) finding happened to co-occur. The
# old structure nested the exit inside `ISSUE_COUNT > 0`, so a commit whose
# only sin was a nil-seam/ignored-error/panic site exited 0 on exactly the
# errors this hook exists to block.
if [ "$BLOCK_COUNT" -gt 0 ]; then
  echo ""
  echo -e "${YELLOW}Summary: $ISSUE_COUNT file(s) with potential issues; $BLOCK_COUNT blocking.${NC}"
  echo ""
  echo -e "${BLUE}Error handling best practices (CLAUDE.md):${NC}"
  echo ""
  echo "  // Wrap errors with context:"
  echo "  if err != nil {"
  echo "      return fmt.Errorf('process file: %w', err)"
  echo "  }"
  echo ""
  echo "  // Don't ignore errors:"
  echo "  if _, err := doSomething(); err != nil {  // NOT: _ = doSomething()"
  echo "      return err"
  echo "  }"
  echo ""
  echo -e "${RED}❌ Commit blocked: $BLOCK_COUNT newly-added ignored-error / panic(err) / nil-seam site(s)${NC}"
  echo ""
  exit 1
fi

if [ "$ISSUE_COUNT" -gt 0 ]; then
  echo ""
  echo -e "${YELLOW}Summary: $ISSUE_COUNT file(s) with potential issues; $BLOCK_COUNT blocking.${NC}"
  echo ""
  echo -e "${YELLOW}⚠️  Remaining items are informational (fmt.Errorf style). Review encouraged but not required.${NC}"
  echo ""
else
  echo -e "${GREEN}✅ Error handling patterns look good (no new issues in added lines)${NC}"
fi

exit 0
