#!/bin/bash
# Pre-commit hook that flags predictable ID generators.
#
# Per CLAUDE.md and project memory:
#   "use pkg/id.Generate() — time.Now().UnixNano() produces predictable IDs"
#
# This hook scans ADDED lines in staged Go files for ID-generation patterns
# that rely on time.Now().UnixNano() (or similar timestamp-based IDs) instead
# of the crypto/rand-backed pkg/id.Generate() helper.
#
# Patterns flagged:
#   1. fmt.Sprintf("<prefix>%d", time.Now().UnixNano())
#   2. fmt.Sprintf("<prefix>%d", time.Now().Unix())
#   3. Direct assignment: someID = time.Now().UnixNano() (where someID suggests an ID)
#   4. Hex/byte manipulation seeded from time.Now().UnixNano()
#
# Suppress with //nolint:predictableids on the same line, e.g. for timestamps
# that are genuinely time values (not IDs).
#
# Installation: Included in .githooks/pre-commit

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Checking for predictable ID generation (added lines only)${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Get staged Go files (excluding test files — tests can use predictable IDs freely)
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null | grep '\.go$' | grep -v '_test\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
  echo -e "${GREEN}✅ No Go source files staged${NC}"
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

ISSUE_COUNT=0
BLOCK_COUNT=0

echo "Checking files:"
echo "$STAGED_GO_FILES" | sed 's/^/  /'
echo ""

for file in $STAGED_GO_FILES; do
  if [ ! -f "$file" ]; then
    continue
  fi

  # Skip generated code
  if grep -q "^// Code generated" "$file" 2>/dev/null; then
    continue
  fi

  # Extract added lines from the staged diff for THIS file.
  ADDED_LINES=$(git diff --cached -U0 -- "$file" 2>/dev/null | grep -E '^\+' | sed 's/^+//')

  if [ -z "$ADDED_LINES" ]; then
    continue
  fi

  FILE_ISSUES=""

  # Pattern 1: fmt.Sprintf with %d fed by time.Now().UnixNano()/Unix()
  # Matches: fmt.Sprintf("something-%d", time.Now().UnixNano())
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    # Skip comments
    echo "$line" | grep -qE '^\s*//' && continue
    # Skip suppression directives
    echo "$line" | grep -q 'nolint:predictableids' && continue
    # Locate in file for line number
    LINE_NUMS=$(grep -nF "$line" "$file" 2>/dev/null | cut -d: -f1)
    for ln in $LINE_NUMS; do
      FILE_ISSUES="${FILE_ISSUES}  ⚠️  fmt.Sprintf with time.Now().UnixNano():\n    $file:$ln\n    > $line\n"
      BLOCK_COUNT=$((BLOCK_COUNT + 1))
    done
  done <<< "$(echo "$ADDED_LINES" | grep -E 'fmt\.Sprintf\([^)]*%d[^)]*,\s*time\.Now\(\)\.(UnixNano|Unix)\(\)' || true)"

  # Pattern 2: Direct UnixNano() assignment to a variable whose name suggests an ID
  # Matches: id = time.Now().UnixNano() or ID: time.Now().UnixNano()
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    echo "$line" | grep -qE '^\s*//' && continue
    echo "$line" | grep -q 'nolint:predictableids' && continue
    LINE_NUMS=$(grep -nF "$line" "$file" 2>/dev/null | cut -d: -f1)
    for ln in $LINE_NUMS; do
      FILE_ISSUES="${FILE_ISSUES}  ⚠️  Variable named like an ID assigned from UnixNano():\n    $file:$ln\n    > $line\n"
      BLOCK_COUNT=$((BLOCK_COUNT + 1))
    done
  done <<< "$(echo "$ADDED_LINES" | grep -iE '(id|guid|uuid|key|msgid|jobid|taskid|sessionid|notifid|eventid)\b.*[:=].*time\.Now\(\)\.UnixNano\(\)' || true)"

  # Pattern 3: byte manipulation seeded from time.Now().UnixNano()
  # Catches the generatePushNotificationID-style pattern: deterministic permutation of timestamp
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    echo "$line" | grep -qE '^\s*//' && continue
    echo "$line" | grep -q 'nolint:predictableids' && continue
    LINE_NUMS=$(grep -nF "$line" "$file" 2>/dev/null | cut -d: -f1)
    for ln in $LINE_NUMS; do
      FILE_ISSUES="${FILE_ISSUES}  ⚠️  Byte/hex manipulation seeded from UnixNano():\n    $file:$ln\n    > $line\n"
      BLOCK_COUNT=$((BLOCK_COUNT + 1))
    done
  done <<< "$(echo "$ADDED_LINES" | grep -E 'time\.Now\(\)\.UnixNano\(\)' | grep -iE 'byte|hex|encode|sprintf|fmt' | grep -vE 'fmt\.Sprintf\([^)]*%d' || true)"

  if [ -n "$FILE_ISSUES" ]; then
    echo -e "${YELLOW}⚠️  $file:${NC}"
    echo -e "$FILE_ISSUES"
    ISSUE_COUNT=$((ISSUE_COUNT + 1))
  fi
done

if [ "$ISSUE_COUNT" -gt 0 ]; then
  echo ""
  echo -e "${YELLOW}Summary: $ISSUE_COUNT file(s) with potential issues; $BLOCK_COUNT blocking.${NC}"
  echo ""
  echo -e "${BLUE}Use pkg/id.Generate(prefix) for unique IDs:${NC}"
  echo ""
  echo "  // WRONG: nanosecond timestamps can collide under concurrency"
  echo "  jobID := fmt.Sprintf(\"dispatch-%d\", time.Now().UnixNano())"
  echo ""
  echo "  // RIGHT: crypto/rand-backed, no collisions, same prefix convention"
  echo "  import \"github.com/caimlas/meept/pkg/id\""
  echo "  jobID := id.Generate(\"dispatch-\")"
  echo ""
  echo -e "${BLUE}Suppress false positives with:${NC}"
  echo "  _ = time.Now().UnixNano() //nolint:predictableids // genuine timestamp, not an ID"
  echo ""

  if [ "$BLOCK_COUNT" -gt 0 ]; then
    echo -e "${RED}❌ Commit blocked: $BLOCK_COUNT predictable-ID site(s)${NC}"
    exit 1
  fi
else
  echo -e "${GREEN}✅ No predictable-ID patterns in added lines${NC}"
fi

exit 0
