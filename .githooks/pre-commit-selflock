#!/bin/bash
# Pre-commit hook: selflock analyzer
#
# Replaces the original grep-heuristic version, which produced false
# positives on doc comments and testdata fixtures (e.g. the selflock
# analyzer's own documentation contains literal "goal.Lock()" /
# "goal.AddActivePlan()" text and tripped the Pattern-1 grep window).
#
# This version runs the real go/analysis AST analyzer
# (tools/analyzers/selflock) on the packages containing staged Go
# files. AST analysis cannot be fooled by comment text, respects the
# //nolint:selflock suppression convention, and only reports genuine
# code patterns.
#
# Compatibility: written for /bin/bash 3.2 (macOS default). No mapfile,
# no associative arrays.

# Color helpers (disabled if output is not a terminal)
if [ -t 1 ]; then
    RED='\033[0;31m'
    YELLOW='\033[1;33m'
    GREEN='\033[0;32m'
    NC='\033[0m'
else
    RED=''
    YELLOW=''
    GREEN=''
    NC=''
fi

echo "🔒 Checking for self-deadlock patterns (AST analyzer)..."

repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

# Collect staged Go files (added, copied, modified, renamed).
# -c color.ui=false / core.quotepath=false keep the filename list clean.
staged_go_files=$(git -c color.ui=false -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR | grep '\.go$' || true)

if [ -z "$staged_go_files" ]; then
    echo "  No Go files staged. Skipping."
    exit 0
fi

# Exclude files under separate Go modules (subdirectories with their own
# go.mod, e.g. sdk/go/). The analyzer runs in the context of the main
# module and cannot resolve packages from nested modules.
nested_module_dirs=""
while IFS= read -r modpath; do
    [ -z "$modpath" ] && continue
    moddir=$(dirname "$modpath")
    if [ "$moddir" != "." ] && [ "$moddir" != "$repo_root" ]; then
        nested_module_dirs="$nested_module_dirs $moddir"
    fi
done < <(git ls-files '*/go.mod')

filtered_files=""
while IFS= read -r f; do
    [ -z "$f" ] && continue
    skip=0
    for moddir in $nested_module_dirs; do
        case "$f" in
            "$moddir"/*) skip=1; break ;;
        esac
    done
    [ "$skip" -eq 1 ] && continue

    # Skip analyzer testdata fixtures: they intentionally contain
    # deadlock-shaped code and are analyzer test inputs, not shipped code.
    case "$f" in
        */testdata/*) continue ;;
    esac

    if [ -z "$filtered_files" ]; then
        filtered_files="$f"
    else
        filtered_files="$filtered_files
$f"
    fi
done <<< "$staged_go_files"

if [ -z "$filtered_files" ]; then
    echo "  No analyzable Go files staged. Skipping."
    exit 0
fi

# Compute unique directory-level package patterns from the file list.
# Cap at 10 packages for speed (matches pre-commit-mutexio).
pkgs_file=$(mktemp)
trap 'rm -f "$pkgs_file" "$output_file"' EXIT

echo "$filtered_files" | while IFS= read -r f; do
    [ -z "$f" ] && continue
    dirname "$f"
done | sort -u | head -n 10 | while IFS= read -r dir; do
    [ -z "$dir" ] && continue
    echo "./${dir}/..."
done > "$pkgs_file"

num_pkgs=$(wc -l < "$pkgs_file" | tr -d ' ')
if [ "$num_pkgs" -eq 0 ]; then
    echo "  No packages to analyze. Skipping."
    exit 0
fi

echo "selflock: analyzing ${num_pkgs} package(s) for self-deadlock patterns..."

# Build argv-array for `go run` (bash 3.2: set --).
set --
while IFS= read -r pkg; do
    [ -z "$pkg" ] && continue
    set -- "$@" "$pkg"
done < "$pkgs_file"

# Run the AST analyzer with a 60-second time budget.
output_file=$(mktemp)

go run ./tools/analyzers/selflock/ "$@" > "$output_file" 2>&1 &
analyzer_pid=$!

elapsed=0
timeout_sec=60
while kill -0 "$analyzer_pid" 2>/dev/null; do
    if [ "$elapsed" -ge "$timeout_sec" ]; then
        printf "${YELLOW}selflock: WARNING -- analyzer exceeded %ss time budget; waiting for completion...${NC}\n" "$timeout_sec"
        break
    fi
    sleep 2
    elapsed=$((elapsed + 2))
done

analyzer_exit=0
wait "$analyzer_pid" 2>/dev/null || analyzer_exit=$?

# Exit 0: no findings.
if [ "$analyzer_exit" -eq 0 ]; then
    printf "%b✅ No self-deadlock patterns detected%b\n" "$GREEN" "$NC"
    exit 0
fi

# singlechecker exits 3 on findings; go run surfaces it as 1.
if grep -q 'selflock' "$output_file"; then
    printf '%b%s%b\n' "$RED" "selflock: self-deadlock patterns found -- commit blocked." "$NC"
    printf '%b%s%b\n' "$RED" "---" "$NC"
    while IFS= read -r line; do
        printf '%b%s%b\n' "$RED" "$line" "$NC"
    done < "$output_file"
    printf '%b%s%b\n' "$RED" "---" "$NC"
    printf '%b%s%b\n' "$RED" "Fix the locking discipline, or suppress a specific site with //nolint:selflock and a justification." "$NC"
    exit 1
fi

# Non-zero exit without findings output: build/compile error.
cat "$output_file"
exit "$analyzer_exit"
