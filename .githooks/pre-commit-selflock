#!/bin/bash
# Pre-commit hook: Detect Go self-deadlock patterns
#
# Catches:
#   1. obj.Lock() followed by obj.Method() where Method has internal locking
#   2. obj.Lock() followed by store.Update(obj) where Update calls obj methods
#
# This is a pattern-based check (grep + AST-lite) since full static analysis
# would require type information and cross-file analysis.

set -euo pipefail

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo "🔒 Checking for self-deadlock patterns..."

DIFF_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
if [ -z "$DIFF_FILES" ]; then
    echo "  No Go files staged. Skipping."
    exit 0
fi

ERRORS_FOUND=0

# Pattern 1: External Lock followed by known internal-lock methods
# These methods have internal locking: AddActivePlan, RemoveActivePlan,
# AppendHistory, Assess, snapshot
PATTERN1_FILES=$(grep -l '\.Lock()' $DIFF_FILES 2>/dev/null | grep -v '_test\.go$' || true)

for file in $PATTERN1_FILES; do
    # Check for the pattern within 10 lines (heuristic)
    if grep -B5 -A10 '\.Lock()' "$file" | grep -qE '\.(AddActivePlan|RemoveActivePlan|AppendHistory|Assess)\('; then
        echo -e "${YELLOW}Warning${NC}: Possible self-deadlock in $file"
        echo "  Pattern: .Lock() followed by method with internal locking"
        grep -n -B2 -A2 '\.Lock()' "$file" | grep -E '\.(Lock|AddActivePlan|RemoveActivePlan|AppendHistory|Assess)\(' || true
        ERRORS_FOUND=1
    fi
done

# Pattern 2: External Lock followed by store.Update with same object
# This is harder to detect with grep alone
for file in $DIFF_FILES; do
    # Look for patterns like:
    #   goal.Lock()
    #   store.Update(ctx, goal)
    #   goal.Unlock()
    if grep -q '\.Lock()' "$file" && grep -q 'Update.*ctx.*' "$file"; then
        # More detailed check: are they in the same function block?
        # This requires AST analysis, so we just warn
        echo -e "${YELLOW}Manual review needed${NC}: $file has Lock() and Update() calls"
        echo "  Verify: Is store.Update called while holding a lock on the same object?"
    fi
done

if [ $ERRORS_FOUND -eq 1 ]; then
    echo -e "${RED}Error: Self-deadlock patterns detected${NC}"
    echo ""
    echo "To fix:"
    echo "  1. Remove external .Lock() if the method has internal locking"
    echo "  2. Or, restructure to avoid calling store.Update while holding locks"
    echo ""
    echo "See: .claude/skills/go-mutex-self-deadlock-store-callback/SKILL.md"
    exit 1
fi

echo "  No self-deadlock patterns detected."
exit 0
