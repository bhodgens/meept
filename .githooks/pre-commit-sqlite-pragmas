#!/bin/bash
# Pre-commit hook: ensures SQLite open calls include WAL + busy_timeout.
#
# Per CLAUDE.md coding practices and recurring bug pattern:
#   "SQLite missing WAL/busy_timeout was the most common bug class"
#
# This hook scans ADDED lines in staged Go files for `sql.Open("sqlite3", ...)`
# or `sql.OpenDB(...)` calls that don't include `_journal_mode=WAL` and
# `_busy_timeout` in the DSN.
#
# Suppress with //nolint:sqlitepragmas on the same line.

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null | grep '\.go$' | grep -v '_test\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

ISSUE_COUNT=0

for file in $STAGED_GO_FILES; do
  [ ! -f "$file" ] && continue
  grep -q "^// Code generated" "$file" 2>/dev/null && continue

  ADDED_LINES=$(git diff --cached -U0 -- "$file" 2>/dev/null | grep -E '^\+' | sed 's/^+//')
  [ -z "$ADDED_LINES" ] && continue

  FILE_ISSUES=""

  # Pattern 1: sql.Open("sqlite3", <path>) without WAL or busy_timeout in the same line
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    echo "$line" | grep -qE '^\s*//' && continue
    echo "$line" | grep -q 'nolint:sqlitepragmas' && continue

    # Must be a sqlite3 open call
    echo "$line" | grep -qE 'sql\.Open\(' || continue
    echo "$line" | grep -q '"sqlite3"' || continue

    # Check for WAL and busy_timeout in the DSN argument
    has_wal=$(echo "$line" | grep -c '_journal_mode=WAL' || true)
    has_busy=$(echo "$line" | grep -c '_busy_timeout' || true)

    if [ "$has_wal" -eq 0 ] || [ "$has_busy" -eq 0 ]; then
      LINE_NUMS=$(grep -nF "$line" "$file" 2>/dev/null | cut -d: -f1)
      for ln in $LINE_NUMS; do
        FILE_ISSUES="${FILE_ISSUES}  ⚠️  sql.Open(\"sqlite3\", ...) missing WAL/busy_timeout:\n    $file:$ln\n    > $line\n"
        ISSUE_COUNT=$((ISSUE_COUNT + 1))
      done
    fi
  done <<< "$ADDED_LINES"

  # Pattern 2: String DSNs built for sqlite that lack pragma params
  # Matches: dsn := "path.db" or dsn := path (where path looks like a db path)
  # followed by sql.Open on next lines — too complex for line-based scan.
  # Only flag inline sql.Open calls (most common pattern).

  if [ -n "$FILE_ISSUES" ]; then
    echo -e "${YELLOW}⚠️  $file:${NC}"
    echo -e "$FILE_ISSUES"
  fi
done

if [ "$ISSUE_COUNT" -gt 0 ]; then
  echo ""
  echo -e "${YELLOW}Summary: $ISSUE_COUNT SQLite open call(s) missing WAL/busy_timeout pragmas.${NC}"
  echo ""
  echo -e "${BLUE}Add WAL mode and busy_timeout to the DSN:${NC}"
  echo ""
  echo "  // WRONG: default journal mode causes 'database is locked' under concurrency"
  echo '  db, err := sql.Open("sqlite3", path)'
  echo ""
  echo "  // RIGHT: WAL + busy_timeout prevents lock contention"
  echo '  dsn := path + "?_journal_mode=WAL&_busy_timeout=5000"'
  echo '  db, err := sql.Open("sqlite3", dsn)'
  echo ""
  echo -e "${BLUE}For DSN strings built conditionally, ensure both params are always present:${NC}"
  echo '  dsn := path'
  echo '  if !strings.Contains(dsn, "?") {'
  echo '      dsn += "?_journal_mode=WAL&_busy_timeout=5000"'
  echo '  } else if !strings.Contains(dsn, "_busy_timeout") {'
  echo '      dsn += "&_busy_timeout=5000"'
  echo '  }'
  echo ""
  echo -e "${BLUE}Suppress false positives with:${NC}"
  echo '  //nolint:sqlitepragmas // pool manages PRAGMAs via PRAGMA statements'
  echo ""
  echo -e "${RED}❌ Commit blocked: $ISSUE_COUNT SQLite pragma site(s)${NC}"
  exit 1
fi

exit 0
