#!/usr/bin/env bash
# Pre-commit hook that runs staticcheck on staged Go packages.
#
# This hook catches real bugs and deprecation that go vet misses:
#   - SA1012 nil context.Context arguments
#   - SA1019 deprecated API usage
#   - SA4004 unconditionally terminated loops
#   - SA4006 unused error values (shadowed error bugs)
#   - SA4011 ineffective break/continue
#   - SA4023 impossible interface comparisons
#   - ST1005 error string formatting
#   - U1000 unused symbols
#
# Requires: staticcheck
#   go install honnef.co/go/tools/cmd/staticcheck@latest
#
# Added 2026-06-19 per docs/20260618-checkreview.md recommendations.

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Running staticcheck on staged packages${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Check if staticcheck is installed
if ! command -v staticcheck &> /dev/null; then
  if [ -x "$HOME/go/bin/staticcheck" ]; then
    STATICCHECK="$HOME/go/bin/staticcheck"
  else
    echo -e "${YELLOW}⚠️  staticcheck not installed, skipping${NC}"
    echo ""
    echo "Install with:"
    echo "  go install honnef.co/go/tools/cmd/staticcheck@latest"
    echo ""
    exit 0
  fi
else
  STATICCHECK="staticcheck"
fi

# Get staged Go files (excluding test files for speed)
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null | grep '\.go$' | grep -v '_test\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
  echo -e "${GREEN}✅ No Go source files staged${NC}"
  exit 0
fi

# Get unique package directories, excluding worktrees/vendor/generated
PACKAGES=$(echo "$STAGED_GO_FILES" \
  | grep -v '\.worktrees/' \
  | grep -v '/vendor/' \
  | grep -v 'zz_generated' \
  | grep -v '\.pb\.go' \
  | xargs -I{} dirname {} \
  | sort -u \
  | sed 's|^|./|')

# Classify each staged package with `go list -e` so a package that FAILS TO
# LOAD is never mistaken for one the default build tags exclude. The old guard
# (`go list "$pkg" >/dev/null 2>&1` as a filter) dropped both cases silently,
# which is how //go:build mage magefiles/*.go became invisible to staticcheck
# (audit F24). Prints exactly one of:
#   ok
#   excluded|<reason>       default tags exclude every file (magefiles)
#   nested-module|<reason>  separate Go module, not part of this one
#   missing|<reason>        path no longer exists in the working tree
#   broken|<reason>         any other load failure (conflicting package clause,
#                           syntax error, unresolved import, ...)
go_list_state() {
  local pat="$1" err
  err="$(go list -e -f '{{with .Error}}{{.Err}}{{end}}' "$pat" 2>&1 | tr '\n' ' ' | sed 's/ *$//')"
  if [ -z "$err" ]; then
    printf 'ok'
    return 0
  fi
  case "$err" in
    *"build constraints exclude all Go files"*) printf 'excluded|%s' "$err" ;;
    *"does not contain package"*)                printf 'nested-module|%s' "$err" ;;
    *"directory not found"*|*"path does not exist"*) printf 'missing|%s' "$err" ;;
    *)                                           printf 'broken|%s' "$err" ;;
  esac
}

# Only magefiles is tag-gated (//go:build mage); no other package in the module
# declares a build tag, so an `excluded` verdict maps to that tag.
MAGE_TAGS="mage"

PACKAGES_UNTAGGED=""
PACKAGES_TAGGED=""
for pkg in $PACKAGES; do
  STATE="$(go_list_state "$pkg")"
  case "$STATE" in
    ok)
      PACKAGES_UNTAGGED="${PACKAGES_UNTAGGED}${pkg}
" ;;
    excluded*)
      echo -e "${YELLOW}SKIP(tag-gated) $pkg: ${STATE#*|}"
      echo -e "  -> analyzing with -tags $MAGE_TAGS, not dropping it${NC}"
      PACKAGES_TAGGED="${PACKAGES_TAGGED}${pkg}
" ;;
    nested-module*|missing*)
      echo -e "${YELLOW}SKIP(${STATE%%|*}) $pkg: ${STATE#*|}${NC}" ;;
    *)
      echo -e "${RED}❌ $pkg could not be loaded — NOT a build-tag exclusion:${NC}"
      echo -e "${RED}   ${STATE#*|}${NC}"
      exit 1 ;;
  esac
done

if [ -z "$PACKAGES_UNTAGGED" ] && [ -z "$PACKAGES_TAGGED" ]; then
  echo -e "${GREEN}✅ No packages to check${NC}"
  exit 0
fi

# Run staticcheck on staged packages.
# Check set rationale (curated 2026-06-19):
#   SA*              real bugs + deprecations (nil-ctx, shadowed err, ineffective break, etc.)
#   U1000            unused symbols
#   S1008/S1009/etc  simplifications (return bool directly, omit nil-before-len, etc.)
# Excluded:
#   ST*              style-guide doc-comment rules (ST1000/20/21/22/03) — hundreds of
#                     findings, low signal, would require project-wide doc rewrite.
#   SA9003           empty branches (often intentional: deferred cleanup, ignored errors)
#   S1039            unnecessary fmt.Sprintf (cosmetic, noisy)
STATICCHECK_CHECKS="SA*,U1000,S1008,S1009,S1021,S1034,-SA9003"

# $1=label, $2=build tags ("" for none), $3=newline-separated package list.
run_staticcheck() {
  local label="$1" tags="$2" list="$3"
  [ -z "$list" ] && return 0
  local out rc
  set --
  while IFS= read -r p; do
    [ -z "$p" ] && continue
    set -- "$@" "$p"
  done <<< "$list"
  [ "$#" -eq 0 ] && return 0

  echo "Checking $label packages:"
  printf '  %s\n' "$@"
  echo ""

  set +e
  if [ -n "$tags" ]; then
    out=$("$STATICCHECK" -checks "$STATICCHECK_CHECKS" -tags "$tags" "$@" 2>&1)
  else
    out=$("$STATICCHECK" -checks "$STATICCHECK_CHECKS" "$@" 2>&1)
  fi
  rc=$?
  set -e
  if [ "$rc" -eq 0 ]; then
    return 0
  fi

  echo -e "${RED}❌ staticcheck found issues ($label):${NC}"
  echo ""
  echo "$out"
  echo ""
  echo -e "${YELLOW}Fix these issues before committing.${NC}"
  echo -e "${BLUE}Suppress legitimate findings with //lint:ignore <check> <reason>${NC}"
  echo -e "${BLUE}or run '$STATICCHECK -show-ignored ./...' to inspect.${NC}"
  echo ""
  return "$rc"
}

run_staticcheck "staged" "" "$PACKAGES_UNTAGGED" || exit $?
if [ -n "$PACKAGES_TAGGED" ]; then
  run_staticcheck "tag-gated (-tags $MAGE_TAGS)" "$MAGE_TAGS" "$PACKAGES_TAGGED" || exit $?
fi

echo -e "${GREEN}✅ staticcheck passed - no issues found${NC}"
exit 0
