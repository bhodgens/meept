#!/opt/homebrew/bin/bash
# Pre-commit hook that runs staticcheck on staged Go packages.
#
# This hook catches real bugs and deprecation that go vet misses:
#   - SA1012 nil context.Context arguments
#   - SA1019 deprecated API usage
#   - SA4004 unconditionally terminated loops
#   - SA4006 unused error values (shadowed error bugs)
#   - SA4011 ineffective break/continue
#   - SA4023 impossible interface comparisons
#   - ST1005 error string formatting
#   - U1000 unused symbols
#
# Requires: staticcheck
#   go install honnef.co/go/tools/cmd/staticcheck@latest
#
# Added 2026-06-19 per docs/20260618-checkreview.md recommendations.

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Running staticcheck on staged packages${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Check if staticcheck is installed
if ! command -v staticcheck &> /dev/null; then
  if [ -x "$HOME/go/bin/staticcheck" ]; then
    STATICCHECK="$HOME/go/bin/staticcheck"
  else
    echo -e "${YELLOW}⚠️  staticcheck not installed, skipping${NC}"
    echo ""
    echo "Install with:"
    echo "  go install honnef.co/go/tools/cmd/staticcheck@latest"
    echo ""
    exit 0
  fi
else
  STATICCHECK="staticcheck"
fi

# Get staged Go files (excluding test files for speed)
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null | grep '\.go$' | grep -v '_test\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
  echo -e "${GREEN}✅ No Go source files staged${NC}"
  exit 0
fi

# Get unique package directories, excluding worktrees/vendor/generated
PACKAGES=$(echo "$STAGED_GO_FILES" \
  | grep -v '\.worktrees/' \
  | grep -v '/vendor/' \
  | grep -v 'zz_generated' \
  | grep -v '\.pb\.go' \
  | xargs -I{} dirname {} \
  | sort -u \
  | sed 's|^|./|')

if [ -z "$PACKAGES" ]; then
  echo -e "${GREEN}✅ No packages to check${NC}"
  exit 0
fi

echo "Checking packages:"
echo "$PACKAGES" | sed 's/^/  /'
echo ""

# Run staticcheck on staged packages
# Check set rationale (curated 2026-06-19):
#   SA*              real bugs + deprecations (nil-ctx, shadowed err, ineffective break, etc.)
#   U1000            unused symbols
#   S1008/S1009/etc  simplifications (return bool directly, omit nil-before-len, etc.)
# Excluded:
#   ST*              style-guide doc-comment rules (ST1000/20/21/22/03) — hundreds of
#                     findings, low signal, would require project-wide doc rewrite.
#   SA9003           empty branches (often intentional: deferred cleanup, ignored errors)
#   S1039            unnecessary fmt.Sprintf (cosmetic, noisy)
if OUTPUT=$("$STATICCHECK" -checks "SA*,U1000,S1008,S1009,S1021,S1034,-SA9003" $PACKAGES 2>&1); then
  :
else
  RC=$?
  echo -e "${RED}❌ staticcheck found issues:${NC}"
  echo ""
  echo "$OUTPUT"
  echo ""
  echo -e "${YELLOW}Fix these issues before committing.${NC}"
  echo -e "${BLUE}Suppress legitimate findings with //lint:ignore <check> <reason>${NC}"
  echo -e "${BLUE}or run '$STATICCHECK -show-ignored ./...' to inspect.${NC}"
  echo ""
  exit "$RC"
fi

echo -e "${GREEN}✅ staticcheck passed - no issues found${NC}"
exit 0
