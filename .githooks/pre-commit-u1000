#!/bin/bash
# Pre-commit hook to detect unused exported/unexported Go code (staticcheck U1000)
#
# This hook runs staticcheck's U1000 check on staged Go packages.
# If unused code is detected, the commit is blocked until the code is
# removed or explicitly suppressed with a //nolint:U1000 directive.
#
# Installation:
#   chmod +x .git/hooks/pre-commit-u1000
#   # Then source from your main pre-commit hook:
#   .git/hooks/pre-commit-u1000 || exit 1

set -e

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Check if staticcheck is installed
if ! command -v staticcheck &>/dev/null; then
  echo -e "${YELLOW}⚠️  staticcheck not installed — skipping U1000 (unused code) check${NC}"
  echo "   Install with: go install honnef.co/go/tools/cmd/staticcheck@latest"
  exit 0
fi

# Collect staged Go files and derive unique package directories.
# Force -c color.ui=false so the filename list is never polluted with
# ANSI escapes (which would break staticcheck's package path args).
STAGED_GO_FILES=$(git -c color.ui=false -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep '\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
  # No Go files staged — nothing to check
  exit 0
fi

# Derive unique package directories from staged Go file paths.
# Each directory is a Go package; we pass them to staticcheck.
# Membership is tested against EXACT lines (the "\n$PACKAGES\n" sandwich):
# a substring test drops a parent package when a subdirectory package was seen
# first (staging internal/llm/metrics/ before internal/llm/ silently skipped
# internal/llm entirely — audit F69).
PACKAGES=""
while IFS= read -r file; do
  # Skip analyzer testdata fixtures: they intentionally contain
  # unused/dead-shaped code as analyzer test inputs, not shipped code.
  case "$file" in
    */testdata/*) continue ;;
  esac
  dir=$(dirname "$file")
  case "
$PACKAGES
" in
    *"
$dir
"*) ;;  # already seen (exact match)
    *) PACKAGES="${PACKAGES}${dir}
" ;;
  esac
done <<< "$STAGED_GO_FILES"

# Classify a staged package with `go list -e` so a package that FAILS TO LOAD
# is never mistaken for one the default build tags exclude. The old guard
# (`if ! go list ...; then continue`) skipped both cases silently, so the hook
# printed "no unused code violations" for packages it never analyzed; that is
# how //go:build mage magefiles/*.go became invisible (audit F24).
# Prints one of: ok | excluded|<reason> | nested-module|<reason> |
#                missing|<reason> | nofiles|<reason> | broken|<reason>
go_list_state() {
  local pat="$1" err rc detail
  rc=0
  # STDOUT IS THE ONLY ERROR CHANNEL: `{{.Error}}` prints on stdout, so the old
  # `2>&1` folded `go list`'s stderr progress ("go: downloading ..." on a cold
  # GOMODCACHE) into the error string, matched no known reason, and hard-failed
  # healthy commits. stderr is consulted only when `go list` exits non-zero with
  # an empty stdout (e.g. "errors parsing go.mod").
  # `|| rc=$?` keeps `set -e` from aborting the hook on an rc!=0 `go list`.
  err="$(go list -e -f '{{with .Error}}{{.Err}}{{end}}' "$pat" 2>/dev/null)" || rc=$?
  err="$(printf '%s\n' "$err" | tr '\n' ' ' | sed 's/ *$//')"
  if [ -z "$err" ]; then
    if [ "$rc" -eq 0 ]; then
      printf 'ok'
      return 0
    fi
    detail="$(go list -e -f '{{with .Error}}{{.Err}}{{end}}' "$pat" 2>&1 >/dev/null | tr '\n' ' ' | sed 's/ *$//')"
    [ -z "$detail" ] && detail="go list exited $rc with no diagnostic"
    printf 'broken|%s' "$detail"
    return 0
  fi
  case "$err" in
    *"build constraints exclude all Go files"*) printf 'excluded|%s' "$err" ;;
    *"no Go files in"*|*"no non-test Go files in"*) printf 'nofiles|%s' "$err" ;;
    *"does not contain package"*)                printf 'nested-module|%s' "$err" ;;
    *"directory not found"*|*"path does not exist"*) printf 'missing|%s' "$err" ;;
    *)                                           printf 'broken|%s' "$err" ;;
  esac
}

# Run staticcheck U1000 on the staged packages.
# -tags=test ensures test-only code is also analyzed. Tag-gated packages
# (magefiles is //go:build mage) get their tag too, so they are analyzed
# instead of dropped.
VIOLATIONS=""
EXIT_CODE=0

while IFS= read -r pkg; do
  [ -z "$pkg" ] && continue
  # Only check if the directory exists (deleted files won't have a dir)
  if [ ! -d "$pkg" ]; then
    continue
  fi

  STATE="$(go_list_state "./${pkg}")"
  TAGS="test"
  case "$STATE" in
    ok) ;;
    excluded*)
      echo -e "${YELLOW}SKIP(tag-gated) $pkg: ${STATE#*|}${NC}"
      echo -e "${YELLOW}  -> analyzing with -tags=test,mage, not dropping it${NC}"
      TAGS="test,mage" ;;
    nested-module*|missing*|nofiles*)
      echo -e "${YELLOW}SKIP(${STATE%%|*}) $pkg: ${STATE#*|}${NC}"
      continue ;;
    *)
      echo -e "${YELLOW}⚠️  U1000: $pkg could not be loaded (NOT a build-tag exclusion):${NC}"
      echo -e "${YELLOW}   ${STATE#*|}${NC}"
      VIOLATIONS="${VIOLATIONS}$pkg: package failed to load (not a build-tag exclusion): ${STATE#*|}
"
      EXIT_CODE=1
      continue ;;
  esac

  OUTPUT=$(staticcheck -checks=U1000 -tags="$TAGS" "./${pkg}/" 2>&1) || EXIT_CODE=1
  if [ -n "$OUTPUT" ]; then
    VIOLATIONS="${VIOLATIONS}${OUTPUT}
"
  fi
done <<< "$PACKAGES"

if [ $EXIT_CODE -ne 0 ] && [ -n "$VIOLATIONS" ]; then
  echo -e "${YELLOW}⚠️  staticcheck U1000: unused code detected in staged packages${NC}"
  echo ""
  echo "$VIOLATIONS" | sed 's/^/  /'
  echo -e "${RED}Commit blocked: remove unused code or suppress with //nolint:U1000${NC}"
  echo ""
  echo "   To bypass: git commit --no-verify (not recommended)"
  exit 1
fi

echo -e "${GREEN}✅ No unused code (U1000) violations detected${NC}"
exit 0
