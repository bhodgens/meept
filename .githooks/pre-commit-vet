#!/bin/bash
# Pre-commit hook that runs go vet on staged Go packages
#
# This hook detects common Go bugs using the built-in vet tool:
# - Unreachable code
# - Invalid printf format strings
# - Possible nil pointer dereferences
# - Shadowed variables
# - And more...
#
# Installation: Included in .githooks/pre-commit

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Running go vet on staged packages${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Get staged Go files (excluding test files for speed)
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null | grep '\.go$' | grep -v '_test\.go$' || true)

if [ -z "$STAGED_GO_FILES" ]; then
  echo -e "${GREEN}✅ No Go source files staged${NC}"
  exit 0
fi

# Get unique package directories
PACKAGES=$(echo "$STAGED_GO_FILES" | xargs -I{} dirname {} | sort -u | sed 's|^|./|')

if [ -z "$PACKAGES" ]; then
  echo -e "${GREEN}✅ No packages to vet${NC}"
  exit 0
fi

echo "Checking packages:"
echo "$PACKAGES" | sed 's/^/  /'
echo ""

# Run go vet on each package
VET_FAILED=false
VET_OUTPUT=""

# Classify a package pattern with `go list -e` so this hook can never treat a
# package that FAILS TO LOAD as if the default build tags excluded it. The old
# guard (`if ! go list "$pkg" >/dev/null 2>&1; then continue`) skipped both
# cases silently, which is how //go:build mage magefiles/*.go became invisible
# to vet/staticcheck/U1000/mutexio/selflock (audit F24).
#
# STDOUT IS THE ONLY ERROR CHANNEL. `{{.Error}}` is printed by `go list` on
# STDOUT, so the old `2>&1` folded unrelated stderr progress into the error
# string: on a COLD module cache a perfectly HEALTHY package produced
#   "go: downloading github.com/go-git/go-git/v5 v5.19.2 ..."
# which matched no known reason, fell through to `broken`, and hard-failed the
# commit on any machine with an empty GOMODCACHE. stderr is now captured
# separately and consulted ONLY when `go list` itself exits non-zero and wrote
# nothing to stdout (e.g. "errors parsing go.mod"). No stderr text can ever be
# mistaken for a package error again.
# Prints exactly one of:
#   ok
#   excluded|<reason>       default tags exclude every file (magefiles)
#   nested-module|<reason>  separate Go module, not part of this one
#   missing|<reason>        path no longer exists in the working tree
#   nofiles|<reason>        no (non-test) Go files to analyze -> SKIP, not a
#                           load failure (e.g. a directory holding only
#                           _-prefixed files). DELIBERATE LOOSENING: the
#                           pre-68b2338c gate classified this as `broken` and
#                           hard-failed the commit — reproduced in /tmp, where a
#                           staged pkg/nofiles/_x.go blocked this hook.
#   broken|<reason>         the ONLY fail-closed verdict, and exactly this
#                           classifier's own contract: `go list` exited non-zero
#                           with an empty stdout (stderr is then consulted for
#                           the reason — "errors parsing go.mod: go.mod:4:
#                           usage: require module/path v1.2.3"), OR {{.Error}}
#                           was non-empty and matched none of the reasons above
#                           ("found packages a (a.go) and b (b.go)" — a
#                           conflicting package clause).
#
# `ok` DOES NOT MEAN "this code compiles". `go list` reports a package with an
# EMPTY {{.Error}} for a SYNTAX ERROR and for an UNRESOLVED IMPORT (both rc=0,
# verified in /tmp), so those land in the `ok` column and are caught by the
# `go vet` run below — never by this classifier. Do not "fix" that here: this
# function answers "did the package load", and a package that loaded is
# analyzable.
go_list_state() {
  local pat="$1" err rc detail
  rc=0
  # stdout only: the {{.Error}} diagnostic, never `go list`'s stderr chatter.
  # `|| rc=$?` keeps `set -e` from aborting the hook on an rc!=0 `go list`.
  err="$(go list -e -f '{{with .Error}}{{.Err}}{{end}}' "$pat" 2>/dev/null)" || rc=$?
  err="$(printf '%s\n' "$err" | tr '\n' ' ' | sed 's/ *$//')"
  if [ -z "$err" ]; then
    if [ "$rc" -eq 0 ]; then
      printf 'ok'
      return 0
    fi
    # rc != 0 with nothing on stdout: `go list` failed before it could report a
    # per-package error. That is a load failure, not a pass — capture the stderr
    # reason for the operator with one extra (warm) call.
    detail="$(go list -e -f '{{with .Error}}{{.Err}}{{end}}' "$pat" 2>&1 >/dev/null | tr '\n' ' ' | sed 's/ *$//')"
    [ -z "$detail" ] && detail="go list exited $rc with no diagnostic"
    printf 'broken|%s' "$detail"
    return 0
  fi
  case "$err" in
    *"build constraints exclude all Go files"*) printf 'excluded|%s' "$err" ;;
    *"no Go files in"*|*"no non-test Go files in"*) printf 'nofiles|%s' "$err" ;;
    *"does not contain package"*)                printf 'nested-module|%s' "$err" ;;
    *"directory not found"*|*"path does not exist"*) printf 'missing|%s' "$err" ;;
    *)                                           printf 'broken|%s' "$err" ;;
  esac
}

# The module's only tag-gated package is magefiles (//go:build mage); no other
# package declares a build tag, so an `excluded` verdict maps to that tag.
build_tags_for() {
  case "$1" in
    ./magefiles) printf 'mage' ;;
    *)           printf '' ;;
  esac
}

for pkg in $PACKAGES; do
  # Skip vendor and generated code
  if echo "$pkg" | grep -q "/vendor/\|/zz_generated\|\.pb\.go"; then
    continue
  fi

  STATE="$(go_list_state "$pkg")"
  case "$STATE" in
    ok) ;;
    excluded*)
      # Real code the default tags hide: analyze it with the tag instead of
      # dropping it, and always print the skip so it cannot look like a pass.
      TAGS="$(build_tags_for "$pkg")"
      echo -e "${YELLOW}SKIP(tag-gated) $pkg: ${STATE#*|}${NC}"
      if [ -n "$TAGS" ]; then
        echo -e "${YELLOW}  -> analyzing with -tags $TAGS${NC}"
        if ! vet_result=$(go vet -tags "$TAGS" "$pkg" 2>&1); then
          VET_FAILED=true
          VET_OUTPUT="${VET_OUTPUT}${pkg} (go vet -tags $TAGS):\n${vet_result}\n\n"
        fi
      else
        echo -e "${YELLOW}  -> no build tag known for $pkg; not analyzed${NC}"
      fi
      continue ;;
    nested-module*|missing*|nofiles*)
      echo -e "${YELLOW}SKIP(${STATE%%|*}) $pkg: ${STATE#*|}${NC}"
      continue ;;
    *)
      # Anything else is a load failure, not an exclusion. Report it as a
      # verdict instead of printing "go vet passed" for code never analyzed.
      VET_FAILED=true
      VET_OUTPUT="${VET_OUTPUT}${pkg} (could not load — NOT a build-tag exclusion):\n${STATE#*|}\n\n"
      continue ;;
  esac

  # Run vet and capture output
  if vet_result=$(go vet "$pkg" 2>&1); then
    continue
  else
    VET_FAILED=true
    VET_OUTPUT="${VET_OUTPUT}${pkg}:\n${vet_result}\n\n"
  fi
done

if [ "$VET_FAILED" = true ]; then
  echo -e "${RED}❌ go vet found issues:${NC}"
  echo ""
  echo -e "$VET_OUTPUT"
  echo ""
  echo -e "${YELLOW}Fix these issues before committing.${NC}"
  echo -e "${BLUE}Tip: Run 'go vet ./...' to see all issues${NC}"
  echo ""
  exit 1
fi

echo -e "${GREEN}✅ go vet passed - no issues found${NC}"
exit 0
