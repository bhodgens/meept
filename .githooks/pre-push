#!/usr/bin/env bash
# Pre-push hook: runs pre-push-vet (whole-tree go vet, test files
# included), then pre-push-e2e (affected hermetic e2e suites over the
# pushed diff), then pre-push-bench (bench regression gate).
#
# WHY these gates: the affected-suite e2e SWEEP moved from pre-commit to
# here (gates-speedup: it cost 15-25 min per commit). pre-push-e2e is now
# the primary local sweep site (FULL scope forced), with CI's e2e-fast job
# as the remote line. pre-push-vet runs FIRST: it is the whole-tree
# compile gate (production AND test files, seconds-long) and must fail
# before the minutes-long e2e and bench gates start. The e2e gate follows
# because it needs no running daemon. Other pre-push checks can be chained
# here.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Pin the toolchain the bench build uses to go.mod's `toolchain` line.
# WHY: the bench tree (~/git/meept-bench) has no toolchain directive, so
# GOTOOLCHAIN=auto would pick the ambient Go — on machines with a newer
# local Go that breaks x/tools-linked gates the same way the pre-commit
# pin fixed (see .githooks/pre-commit:35-45). auto resolves to the pin;
# any other explicit value wins as a deliberate probe.
if [ -z "$GOTOOLCHAIN" ] || [ "$GOTOOLCHAIN" = "auto" ]; then
    export GOTOOLCHAIN="$(sed -n 's/^toolchain[[:space:]]//p' "$PWD/go.mod" | head -1)"
fi
if [ -z "$GOTOOLCHAIN" ]; then
    export GOTOOLCHAIN="$(sed -n 's/^go[[:space:]]//p' "$PWD/go.mod" | head -1)"
fi

"$SCRIPT_DIR/pre-push-vet" || exit 1
"$SCRIPT_DIR/pre-push-e2e" "$remote" || exit 1
"$SCRIPT_DIR/pre-push-bench" || exit 1

exit 0
