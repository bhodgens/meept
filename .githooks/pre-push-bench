#!/opt/homebrew/bin/bash
# Pre-push hook: run the meept-bench regression gate before pushing.
#
# Blocks the push when the benchmark regression suite regresses against
# the committed baseline (results/baseline/regression.jsonl in
# ~/git/meept-bench). One known-failure task (memory-recall-marker) is
# pinned red by design; the diff gate treats fail->fail as unchanged.
#
# Requires:
#   - meept-daemon running (local socket ~/.meept/meept.sock)
#   - meept-bench repo at $MEEPT_BENCH_DIR (default ~/git/meept-bench)
#
# Skip with: git push --no-verify
# Override for a single push: MEEPT_BENCH_SKIP=1 git push

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

if [ "${MEEPT_BENCH_SKIP}" = "1" ]; then
  echo -e "${YELLOW}⏭  MEEPT_BENCH_SKIP=1 — skipping bench gate${NC}"
  exit 0
fi

BENCH_DIR="${MEEPT_BENCH_DIR:-$HOME/git/meept-bench}"
BENCH_BIN="$BENCH_DIR/meept-bench-bin"
BASELINE="$BENCH_DIR/results/baseline/regression.jsonl"
OUT="$BENCH_DIR/results/gate-pre-push"

if [ ! -d "$BENCH_DIR" ]; then
  echo -e "${YELLOW}⏭  meept-bench not found at $BENCH_DIR — skipping bench gate${NC}"
  exit 0
fi

echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Pre-push Bench Regression Gate${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Build the bench binary from the current bench tree.
if ! (cd "$BENCH_DIR" && go build -o "$BENCH_BIN" ./cmd/meept-bench); then
  echo -e "${RED}❌ Failed to build meept-bench — fix or push with --no-verify${NC}"
  exit 1
fi

# Daemon must be reachable, else every task would error.
if ! "$BENCH_BIN" doctor >/dev/null 2>&1; then
  echo -e "${YELLOW}⚠  meept daemon unreachable — cannot run bench gate.${NC}"
  echo -e "${YELLOW}   Start the daemon, or push with --no-verify / MEEPT_BENCH_SKIP=1.${NC}"
  exit 1
fi

# Run the gate.
mkdir -p "$OUT"
if ! "$BENCH_BIN" run --suite "$BENCH_DIR/suites/regression.json" \
     --out "$OUT" --auto-approved; then
  RUN_EXIT=$?
  echo ""
  echo -e "${RED}❌ Bench suite run failed (exit $RUN_EXIT) — push blocked.${NC}"
  echo -e "   Details: $OUT/scorecard.md"
  exit 1
fi

# Diff against the committed baseline. Exit 1 = regressed.
if ! "$BENCH_BIN" diff \
     --baseline "$BENCH_DIR/results/baseline/regression.jsonl" \
     --current  "$OUT/results.jsonl"; then
  echo ""
  echo -e "${RED}❌ REGRESSION detected vs baseline — push blocked.${NC}"
  echo -e "   Fix the regression, or re-baseline deliberately:"
  echo -e "   cp $OUT/results.jsonl $BASELINE"
  exit 1
fi

echo ""
echo -e "${GREEN}✅ Bench gate clean — pushing.${NC}"
exit 0
