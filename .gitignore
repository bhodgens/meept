# …except the classifier-eval campaign artifacts (evidence for
# docs/plans/classifier-iteration — iteration reports + summaries).
!tools/classifier-eval/results/
!tools/classifier-eval/results/**
# Hermes-transcript replay corpus: verbatim private chat text, never tracked
tools/classifier-eval/replay-corpus.local.json5

# Skill-evolution cycle output (regenerable daemon artifacts, churn every cycle)
docs/plans/skill-evolution-*.md
# silver adjudication working sheet (contains verbatim transcript text)
tools/classifier-eval/SILVER-ADJUDICATION-SHEET.md
tools/classifier-eval/silver_adjudication_rows.json
tools/classifier-eval/silver_adjudication_data.json
# gold-promoted replay corpus (verbatim transcript text, adjudicated)
tools/classifier-eval/replay-gold.local.json5
# any renamed/derived local variant of the private corpora and their
# working files, including inside the re-included results tree (the
# `!results/**` rules above re-open that directory, so this rule must
# come after them to win; legitimate tracked fixtures are not *.local.*)
tools/classifier-eval/**/*.local.json5

# memory calibration artifacts (raw conversation text — never commit)
rejected_candidates.jsonl
claim_verdicts.jsonl
raw_responses.jsonl

