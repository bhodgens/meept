//go:build e2e

// Gate tests for the hostile second pass (leaf 03; contracts C2 and C5
// in docs/plans/20261101-fresh-context-critic/master.md).
//
// PARKED as .staged. Leaf 03 re-activates ONLY this file. It pins:
//
//	F4 TestHostilePassSkipsSameModel (C5: hostile chatter nil or its
//	   model ref equal to the planner ref means SKIP with the
//	   strategic_planner.hostile_critic_skipped metric; the planner
//	   chatter never receives the hostile prompt and is never used as a
//	   hostile fallback)
//	F5 TestHostilePassDoesNotCallSpawnVerifier (the plan critic never
//	   routes a plan draft into the implementation verifier; asserted
//	   through the counter seam agent.PlanCriticSpawnVerifierCalls()
//	   that leaf 03 must export, default 0)
//
// Self-contained on purpose: helpers here are uniquely prefixed so this
// file compiles alone when the sibling .staged files are still parked.
package plancritic

import (
	"context"
	"encoding/json"
	"io"
	"log/slog"
	"path/filepath"
	"strings"
	"sync"
	"testing"
	"time"

	"github.com/caimlas/meept/internal/agent"
	"github.com/caimlas/meept/internal/bus"
	"github.com/caimlas/meept/internal/config"
	"github.com/caimlas/meept/internal/llm"
	"github.com/caimlas/meept/internal/task"
)

// hostileED is the plan-dialect em-dash via escape (ASCII-only source).
const hostileED = "\u2014"

// hostileModelChatter is a scripted llm.Chatter that reports a fixed
// model ref (Config) and records every prompt. C5's skip rule compares
// model refs, so the distinct-vs-planner distinction rides ModelID.
type hostileModelChatter struct {
	modelID string
	mu      sync.Mutex
	resps   []string
	prompts []string
	callIdx int
}

func (c *hostileModelChatter) Chat(_ context.Context, messages []llm.ChatMessage, _ ...llm.ChatOption) (*llm.Response, error) {
	c.mu.Lock()
	defer c.mu.Unlock()
	var sb strings.Builder
	for _, m := range messages {
		sb.WriteString(m.Role)
		sb.WriteString(": ")
		sb.WriteString(m.Content)
		sb.WriteString("\n")
	}
	c.prompts = append(c.prompts, sb.String())
	i := c.callIdx
	c.callIdx++
	resp := c.resps[len(c.resps)-1]
	if i < len(c.resps) {
		resp = c.resps[i]
	}
	return &llm.Response{Content: resp, FinishReason: "stop", Usage: llm.TokenUsage{TotalTokens: 5}}, nil
}

func (c *hostileModelChatter) ChatWithProgress(ctx context.Context, messages []llm.ChatMessage, progress llm.ProgressCallback, opts ...llm.ChatOption) (*llm.Response, error) {
	return c.Chat(ctx, messages, opts...)
}

func (c *hostileModelChatter) Config() *llm.ModelConfig {
	return &llm.ModelConfig{ModelID: c.modelID}
}

func (c *hostileModelChatter) callCount() int {
	c.mu.Lock()
	defer c.mu.Unlock()
	return c.callIdx
}

func (c *hostileModelChatter) promptCopy() []string {
	c.mu.Lock()
	defer c.mu.Unlock()
	return append([]string(nil), c.prompts...)
}

// hostileDraft is a minimal plan-dialect v1 document the compiler accepts.
func hostileDraft() string {
	return "# Plan: Hostile e2e\n\n## Meta\n\n- task_id: t-hostile-e2e\n- version: 1\n- status: draft\n- updated: 2026-11-01\n\n" +
		"## Goal\n\nProduce the artifact end to end.\n\n## Decisions\n\n- Decision: do it directly " + hostileED +
		" Rationale: scope is small.\n\n## Open Questions\n\n## Phases\n\n### Phase 1: Build\n\nBuild the artifact.\n\n" +
		"**Produces:**\n\n- `hostile-e2e-artifact` (file) " + hostileED + " the finished artifact\n\n**Consumes:** none\n\n" +
		"**Steps:**\n\n1. Implement the artifact end to end [code]\n2. Verify the artifact [analyze] (needs: Phase1.S1)\n"
}

// hostileFixture bundles the planner with the store it was built on.
type hostileFixture struct {
	SP    *agent.StrategicPlanner
	Store *task.Store
}

// hostilePlanner builds a StrategicPlanner whose planner-side chatter has
// the given model ref (the planner model for C5 comparisons).
func hostilePlanner(t *testing.T, plannerModel string, chatter *hostileModelChatter) hostileFixture {
	t.Helper()
	logger := slog.New(slog.NewTextHandler(io.Discard, nil))
	msgBus := bus.New(nil, logger)
	t.Cleanup(func() { msgBus.Close() })
	store, err := task.NewStore(filepath.Join(t.TempDir(), "tasks.db"), logger)
	if err != nil {
		t.Fatalf("task store: %v", err)
	}
	t.Cleanup(func() { store.Close() })
	reg := agent.NewAgentRegistry(agent.RegistryConfig{
		Logger:         logger,
		PlannerChatter: chatter,
	})
	if err := reg.RegisterSpec(&agent.AgentSpec{
		ID:      config.AgentIDPlanner,
		Name:    "Planner",
		Role:    agent.RoleExecutor,
		Enabled: true,
	}); err != nil {
		t.Fatalf("register planner spec: %v", err)
	}
	sp := agent.NewStrategicPlanner(agent.StrategicPlannerConfig{
		Registry:       reg,
		TaskStore:      store,
		StepStore:      store.StepStore(),
		Bus:            msgBus,
		MaxPlanSteps:   5,
		PlannerTimeout: 10 * time.Second,
		Logger:         logger,
	})
	sp.SetPlanCompilerEnabled(true)
	sp.SetCritiqueMaxRounds(2)
	sp.SetCritiqueChatter(chatter)
	return hostileFixture{SP: sp, Store: store}
}

func hostileTask(t *testing.T, fx hostileFixture, id string) string {
	t.Helper()
	tsk := task.NewTask("hostile-e2e", "comprehensive avatar upload feature")
	tsk.ID = id
	tsk.SetState(task.StatePlanning)
	if err := fx.Store.Create(tsk); err != nil {
		t.Fatalf("create task: %v", err)
	}
	return id
}

func hostileReq(taskID string) agent.PlanRequest {
	return agent.PlanRequest{
		TaskID:    taskID,
		SessionID: "sess-hostile-e2e",
		Input:     "comprehensive avatar upload feature",
		Intent:    "code",
		Mode:      "plan",
	}
}

// hostileTaskMeta reads the task's critique_outcome metadata stamp.
func hostileTaskOutcome(t *testing.T, fx hostileFixture, id string) string {
	t.Helper()
	tsk, err := fx.Store.GetByID(id)
	if err != nil || tsk == nil {
		t.Fatalf("F4: task %s not found: %v", id, err)
	}
	var m map[string]any
	if len(tsk.Metadata) > 0 {
		if jsonErr := json.Unmarshal(tsk.Metadata, &m); jsonErr != nil {
			t.Fatalf("F4: unmarshal task metadata: %v", jsonErr)
		}
	}
	if v, ok := m["critique_outcome"].(string); ok {
		return v
	}
	return ""
}

// F4 (C5): hostile enabled with a NIL chatter means skip: no hostile
// prompt anywhere, the planner chatter call count does not grow past the
// critique round's own calls, and the outcome stamps hostile_skipped
// (a skipped pass is not a clean seal).
func TestHostilePassSkipsSameModel(t *testing.T) {
	chatter := &hostileModelChatter{modelID: "planner-model", resps: []string{
		hostileDraft(),       // draft fill
		`{"objections": []}`, // critic round 1: clean
	}}
	fx := hostilePlanner(t, "planner-model", chatter)
	fx.SP.SetHostileCriticEnabled(true) // C2 setter (RED today: undefined)
	fx.SP.SetHostileCriticChatter(nil)  // C5: nil chatter = skip, never planner fallback
	taskID := hostileTask(t, fx, "task-hostile-nil")

	res, err := fx.SP.PlanCritiqueFlow(context.Background(), hostileReq(taskID), &agent.PlanCritiqueInput{})
	if err != nil {
		t.Fatalf("PlanCritiqueFlow: %v", err)
	}
	// C5: a skipped hostile pass is not "clean".
	if got := hostileTaskOutcome(t, fx, taskID); got != "hostile_skipped" {
		t.Fatalf("F4 (C5): critique_outcome = %q, want hostile_skipped (skipped pass must not seal clean)", got)
	}
	// The result must not report a fully clean/self-sealed outcome.
	if strings.Contains(res.CritiqueSummary, "clean") {
		t.Fatalf("F4 (C5): critique summary reports clean despite the skipped hostile pass: %q", res.CritiqueSummary)
	}

	// Same-model variant: a chatter whose model ref equals the planner's
	// is also a skip (reason same_model), never a fallback.
	sameModel := &hostileModelChatter{modelID: "planner-model", resps: []string{
		`{"paraphrase":{"proposes":"x","system_context":"y"},"objections":[]}`,
	}}
	fx.SP.SetHostileCriticChatter(sameModel) // C5: same model ref = skip
	before := chatter.callCount()
	if _, err := fx.SP.PlanCritiqueFlow(context.Background(), hostileReq(taskID), &agent.PlanCritiqueInput{}); err != nil {
		t.Fatalf("PlanCritiqueFlow (same-model): %v", err)
	}
	if sameModel.callCount() != 0 {
		t.Fatalf("F4 (C5): same-model hostile chatter was called %d times, want 0 (same model = skip, never run)", sameModel.callCount())
	}
	if got := hostileTaskOutcome(t, fx, taskID); got != "hostile_skipped" {
		t.Fatalf("F4 (C5): same-model outcome = %q, want hostile_skipped", got)
	}
	// The planner chatter grew only by the second flow's own critique
	// calls; it must never have received a hostile-stance prompt.
	for _, p := range chatter.promptCopy()[before:] {
		if strings.Contains(p, "hostile") && strings.Contains(p, "Assume the plan is wrong") {
			t.Fatal("F4 (C5): the hostile prompt must never reach the planner chatter")
		}
	}
}

// F5: the plan critic never calls SpawnVerifier (the implementation
// verifier runs shell and tests; a plan critic has no tools). Asserted
// through the counter seam agent.PlanCriticSpawnVerifierCalls() that
// leaf 03 must export. RED today: the function is undefined.
func TestHostilePassDoesNotCallSpawnVerifier(t *testing.T) {
	if got := agent.PlanCriticSpawnVerifierCalls(); got != 0 {
		t.Fatalf("F5: PlanCriticSpawnVerifierCalls() = %d, want 0 before any critic run", got)
	}

	chatter := &hostileModelChatter{modelID: "planner-model", resps: []string{
		hostileDraft(),       // draft fill
		`{"objections": []}`, // critic round 1: clean
	}}
	fx := hostilePlanner(t, "planner-model", chatter)
	fx.SP.SetHostileCriticEnabled(true)
	hostile := &hostileModelChatter{modelID: "hostile-model", resps: []string{
		`{"paraphrase":{"proposes":"upload avatars","system_context":"single user"},"objections":[]}`,
	}}
	fx.SP.SetHostileCriticChatter(hostile) // distinct model: the pass RUNS
	taskID := hostileTask(t, fx, "task-hostile-verifier")

	if _, err := fx.SP.PlanCritiqueFlow(context.Background(), hostileReq(taskID), &agent.PlanCritiqueInput{}); err != nil {
		t.Fatalf("PlanCritiqueFlow: %v", err)
	}
	if hostile.callCount() == 0 {
		t.Fatal("F5: distinct-model hostile pass did not run; the pass must use its own chatter when wired")
	}
	if got := agent.PlanCriticSpawnVerifierCalls(); got != 0 {
		t.Fatalf("F5: PlanCriticSpawnVerifierCalls() = %d after a hostile run, want 0 (the plan critic must never call SpawnVerifier)", got)
	}
}
