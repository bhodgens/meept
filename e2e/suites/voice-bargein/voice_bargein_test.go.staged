//go:build e2e

// Suite voice-bargein (master Test Gate): interrupt mid-say; the clear frame
// is observed on the fake Telnyx socket and the OTHER call's say stream is
// unaffected (per-call barge-in isolation, C1). Parked .staged from leaf
// 00T; leaf 15 activates + registers the manifest entry.
package voicebargein

import (
	"testing"
	"time"

	"github.com/caimlas/meept/e2e/harness"
)

// TestVoiceBargeinIsolatesCalls runs two concurrent calls (two employees,
// two numbers) and interrupts call A mid-say: call A's Telnyx side receives
// {"event":"clear"} and drops queued speech for THAT call only; call B keeps
// saying frames.
func TestVoiceBargeinIsolatesCalls(t *testing.T) {
	fake := newFakeTelnyx(t)
	s := harness.Start(t,
		harness.WithConfigOverlay(map[string]any{
			"voice.enabled":                true,
			"voice.public_stream_url":      fake.streamURL(),
			"voice.connection_id":          "conn-e2e-barge",
			"voice.from_number":            "+15551000001",
			"voice.allowed_numbers":        []string{"+15552000001", "+15552000002"},
			"voice.telnyx_public_key":      fake.publicKeyB64(),
			"voice.telnyx_base_url":        fake.baseURL(),
			"voice.max_concurrent_calls":   4,
			"voice.supervisor_timeout_ms":  400,
		}),
	)

	fake.deliverCallInitiated(t, s, "cc-barge-a", "+15552000001", "+15551000001", "incoming")
	fake.deliverCallInitiated(t, s, "cc-barge-b", "+15552000002", "+15551000001", "incoming")
	fake.awaitAnswered(t, "cc-barge-a", 10*time.Second)
	fake.awaitAnswered(t, "cc-barge-b", 10*time.Second)

	// Both calls get a long employee answer playing (multi-chunk say).
	fake.childSendsPrompt(t, "cc-barge-a", "Tell me everything about my day in detail.", true)
	fake.childSendsPrompt(t, "cc-barge-b", "Tell me everything about my day in detail.", true)
	fake.awaitSayContaining(t, "cc-barge-a", 15*time.Second)
	fake.awaitSayContaining(t, "cc-barge-b", 15*time.Second)

	// Barge into A only.
	fake.childSendsInterrupt(t, "cc-barge-a")

	// A's Telnyx media socket observes the clear frame.
	fake.awaitClearFrame(t, "cc-barge-a", 5*time.Second)

	// B is untouched: its say stream keeps advancing after A's clear.
	before := fake.sayFrameCount(t, "cc-barge-b")
	time.Sleep(300 * time.Millisecond)
	after := fake.sayFrameCount(t, "cc-barge-b")
	if after <= before {
		t.Errorf("call B say stream stalled after barge-in on call A (frames %d -> %d)", before, after)
	}

	// A's queue was dropped: no further say frames for A after the clear.
	time.Sleep(200 * time.Millisecond)
	if n := fake.sayFrameCountAfterClear(t, "cc-barge-a"); n != 0 {
		t.Errorf("call A emitted %d say frames after clear, want 0 (queued speech dropped for THAT call only)", n)
	}
}
