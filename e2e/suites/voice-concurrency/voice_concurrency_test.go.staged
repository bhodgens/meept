//go:build e2e

// Suite voice-concurrency (master Test Gate + C8): two employees, two
// numbers, simultaneous calls both live at once; the third call to an
// already-live target is refused ErrDuplicateTarget and a call over
// max_concurrent_calls is refused ErrBusy. Parked .staged from leaf 00T;
// leaf 15 activates + registers the manifest entry.
package voiceconcurrency

import (
	"testing"
	"time"

	"github.com/caimlas/meept/e2e/harness"
)

// TestVoiceConcurrentCallsAcrossEmployees runs two employees on two numbers
// simultaneously: both calls are answered and both say streams advance
// independently.
func TestVoiceConcurrentCallsAcrossEmployees(t *testing.T) {
	fake := newFakeTelnyx(t)
	s := harness.Start(t,
		harness.WithConfigOverlay(map[string]any{
			"voice.enabled":               true,
			"voice.public_stream_url":     fake.streamURL(),
			"voice.connection_id":         "conn-e2e-conc",
			"voice.from_number":           "+15551000001",
			"voice.allowed_numbers":       []string{"+15552000001", "+15552000002"},
			"voice.telnyx_public_key":     fake.publicKeyB64(),
			"voice.telnyx_base_url":       fake.baseURL(),
			"voice.max_concurrent_calls":  4,
			"voice.supervisor_timeout_ms": 400,
		}),
	)

	// Simultaneous: both initiated before either is answered.
	fake.deliverCallInitiated(t, s, "cc-conc-1", "+15552000001", "+15551000001", "incoming")
	fake.deliverCallInitiated(t, s, "cc-conc-2", "+15552000002", "+15551000001", "incoming")

	fake.awaitAnswered(t, "cc-conc-1", 10*time.Second)
	fake.awaitAnswered(t, "cc-conc-2", 10*time.Second)

	fake.childSendsPrompt(t, "cc-conc-1", "Status?", true)
	fake.childSendsPrompt(t, "cc-conc-2", "Status?", true)
	fake.awaitSayContaining(t, "cc-conc-1", 15*time.Second)
	fake.awaitSayContaining(t, "cc-conc-2", 15*time.Second)
}

// TestVoiceDuplicateTargetRefused pins C8 end to end: while a call to a
// target is live, a second call to the SAME number is refused at the webhook
// boundary (HTTP status naming the duplicate), never double-rung.
func TestVoiceDuplicateTargetRefused(t *testing.T) {
	fake := newFakeTelnyx(t)
	s := harness.Start(t,
		harness.WithConfigOverlay(map[string]any{
			"voice.enabled":               true,
			"voice.public_stream_url":     fake.streamURL(),
			"voice.connection_id":         "conn-e2e-dup",
			"voice.from_number":           "+15551000001",
			"voice.allowed_numbers":       []string{"+15552000003"},
			"voice.telnyx_public_key":     fake.publicKeyB64(),
			"voice.telnyx_base_url":       fake.baseURL(),
			"voice.max_concurrent_calls":  4,
			"voice.supervisor_timeout_ms": 400,
		}),
	)

	fake.deliverCallInitiated(t, s, "cc-dup-1", "+15552000003", "+15551000001", "incoming")
	fake.awaitAnswered(t, "cc-dup-1", 10*time.Second)

	// Second inbound ring for the same target number while live.
	status := fake.deliverCallInitiatedExpectStatus(t, s, "cc-dup-2", "+15552000003", "+15551000001", "incoming")
	if status < 400 {
		t.Errorf("duplicate live target accepted with status %d, want a 4xx refusal (ErrDuplicateTarget)", status)
	}

	// The refused call never answers.
	fake.assertNoAnswer(t, "cc-dup-2", 2*time.Second)
}
