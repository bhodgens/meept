package builtin

// F10 gate T2/T2b (04-tool-surface/00T-tests.md): lsp_navigate tool.
// Pins contract B2 (.hermes/contracts/04-tool-surface.md):
//   - Name() "lsp_navigate"; IsReadOnly -> true; TimeoutMs() -> 60s (B1)
//   - operations: goToDefinition | findReferences | goToImplementation | hover
//   - one-based UTF-16 line/character map to zero-based seam positions
//   - result caps DEFAULT_MAX_LOCATIONS=100, DEFAULT_MAX_RESULT_CHARS=16000
//   - unresolvable workspace -> detectable error containing "workspace cwd",
//     mirroring tools.ErrNoWorkingDir semantics, isError true
//
// RED until leaf 02-lsp-navigation lands (NewLSPNavigateTool etc. undefined).

import (
	"context"
	"errors"
	"strings"
	"testing"
	"time"

	"github.com/caimlas/meept/internal/tools"
)

func TestLSPNavigateTool_Registration(t *testing.T) {
	reg := tools.NewRegistry()
	RegisterLSPNavigateTool(reg, nil) // nil manager: registration must not require a live server

	tool := reg.GetTool("lsp_navigate")
	if tool == nil {
		t.Fatal("lsp_navigate not registered")
	}
	if !tool.IsReadOnly(map[string]any{"operation": "goToDefinition"}) {
		t.Error("lsp_navigate must be read-only")
	}
	if got := tool.TimeoutMs(); got != 60*time.Second {
		t.Errorf("TimeoutMs() = %v, want 60s (B1 consumer)", got)
	}
}

func TestLSPNavigateTool_ArgParsing(t *testing.T) {
	// One-based UTF-16 coords must map to zero-based seam positions.
	// parseLspArgs is the exported-for-test seam named in the leaf T2 row.
	args := map[string]any{
		"operation": "goToDefinition",
		"file_path": "a.go",
		"line":      float64(5),
		"character": float64(1),
	}
	req, err := parseLspArgs(args)
	if err != nil {
		t.Fatalf("parseLspArgs: %v", err)
	}
	if req.Operation != "goToDefinition" {
		t.Errorf("Operation = %q", req.Operation)
	}
	if req.Line != 4 || req.Character != 0 {
		t.Errorf("one-based (5,1) must map to zero-based (4,0), got (%d,%d)", req.Line, req.Character)
	}
	if req.FilePath != "a.go" {
		t.Errorf("FilePath = %q", req.FilePath)
	}
}

func TestLSPNavigateTool_RejectsUnknownOperation(t *testing.T) {
	_, err := parseLspArgs(map[string]any{
		"operation": "renameSymbol",
		"file_path": "a.go",
		"line":      float64(1),
		"character": float64(1),
	})
	if err == nil {
		t.Fatal("unknown operation must be rejected")
	}
}

func TestLSPNavigateTool_RejectsNonPositiveCoords(t *testing.T) {
	_, err := parseLspArgs(map[string]any{
		"operation": "hover",
		"file_path": "a.go",
		"line":      float64(0), // one-based: 0 is invalid
		"character": float64(1),
	})
	if err == nil {
		t.Fatal("line=0 must be rejected (coords are one-based)")
	}
}

func TestLSPNavigateTool_WorkspaceSentinel(t *testing.T) {
	// T2b: an unresolvable workspace yields a detectable "workspace cwd"
	// error (mirrors tools.ErrNoWorkingDir), surfaced as a tool error.
	tool := NewLSPNavigateTool(nil)
	res, err := tool.Execute(context.Background(), map[string]any{
		"operation": "goToDefinition",
		"file_path": "a.go",
		"line":      float64(1),
		"character": float64(1),
		// no workspace, no session working dir injected in ctx
	})
	if err == nil {
		// Some tools surface failure via the result envelope instead of err.
		tr, ok := res.(tools.ToolResult)
		if !ok || tr.Success {
			t.Fatal("expected a workspace failure, got success")
		}
		if !strings.Contains(tr.Error, "workspace cwd") {
			t.Errorf("error %q must contain 'workspace cwd'", tr.Error)
		}
		return
	}
	if !strings.Contains(err.Error(), "workspace cwd") {
		t.Errorf("error %q must contain 'workspace cwd'", err)
	}
	if !errors.Is(err, tools.ErrNoWorkingDir) && !tools.IsNoWorkingDir(err) {
		t.Error("workspace failure must mirror the tools.ErrNoWorkingDir sentinel semantics")
	}
}

func TestLSPNavigateTool_ResultCaps(t *testing.T) {
	// The caps are contract constants: 100 locations, 16000 chars.
	if DefaultMaxLocations != 100 {
		t.Errorf("DefaultMaxLocations = %d, want 100", DefaultMaxLocations)
	}
	if DefaultMaxResultChars != 16000 {
		t.Errorf("DefaultMaxResultChars = %d, want 16000", DefaultMaxResultChars)
	}
}
