#!/usr/bin/env bash
#
# pre-commit hook: DELEGATES to the tracked hook set in .githooks/.
#
# The canonical checks live in .githooks/pre-commit (orchestrator) plus its
# 15 sub-hooks. This file remains only for tooling that references
# scripts/pre-commit by path; it forwards to the orchestrator. Install with
# `make hooks`, which sets core.hooksPath to .githooks.
#
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
exec "$repo_root/.githooks/pre-commit"
