    { id: "short-008", input: "fix it", expected_intent: "debug", expected_agent: "debugger", added_in: "iteration-2", source: "synthetic" },

    // ---- failure class 1: near-boundary intent pairs ----
    { id: "bound-001", input: "the login endpoint throws a 401 on valid credentials", expected_intent: "debug", expected_agent: "debugger", added_in: "iteration-2", source: "synthetic" },
    { id: "bound-002", input: "compare the top three vector databases for our stack", expected_intent: "search", expected_agent: "analyst", added_in: "iteration-2", source: "synthetic" },
    { id: "bound-003", input: "design the architecture for the notification service", expected_intent: "plan", expected_agent: "planner", added_in: "iteration-2", source: "synthetic" },
    { id: "bound-004", input: "research whether WebGPU is ready for production use", expected_intent: "analyze", expected_agent: "analyst", added_in: "iteration-2", source: "synthetic" },
